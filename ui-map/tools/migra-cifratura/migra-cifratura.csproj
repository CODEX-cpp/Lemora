<Project Sdk="Microsoft.NET.Sdk">
  <!-- strumento usato una volta sola: converte un database di Lemora dalla vecchia cifratura (pacchetto 1Remote.Security) alla cassaforte nuova.
       L'app non contiene piu' la vecchia libreria: serve solo qui. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MigraCifratura</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="1Remote.Security" Version="1.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>
  <ItemGroup>
    <!-- la stessa cassaforte dell'app, non una copia -->
    <Compile Include="..\..\..\Ui\Utils\DataVault.cs" Link="DataVault.cs" />
  </ItemGroup>
</Project>
