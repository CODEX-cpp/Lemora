<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Lemora.Server</AssemblyName>
    <ApplicationIcon>Lemora.ico</ApplicationIcon>
    <RootNamespace>Lemora.Server</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- niente librerie di localizzazione ICU: il server gira anche su Linux senza pacchetti in piu' -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- la console web sta dentro l'exe: un solo file da copiare sul server -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- SQLite nativo aggiornato: quello incluso in Microsoft.Data.Sqlite (2.1.10) ha la falla CVE-2025-6965 (SQLite prima della 3.50.2) -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.14" />
    <!-- permette all'exe di girare come servizio Windows (risponde al gestore dei servizi); fuori dal servizio non fa nulla -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
  </ItemGroup>

</Project>
