<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fpx="clr-namespace:Lemora.Utils">
    <!-- stile condiviso del trasferimento file (popup, navigatore): righe della coda, barra di avanzamento, pulsanti di testo -->

    <SolidColorBrush x:Key="FtUploadBg" Color="#1F2A30" />
    <SolidColorBrush x:Key="FtDownloadBg" Color="#1F2B22" />
    <SolidColorBrush x:Key="FtDownloadFg" Color="#81C995" />
    <SolidColorBrush x:Key="FtOkBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="FtWarnBrush" Color="#FDD663" />
    <SolidColorBrush x:Key="FtErrBrush" Color="#FF9B94" />
    <SolidColorBrush x:Key="FtTrackBrush" Color="#2E2E2E" />
    <SolidColorBrush x:Key="FtRowHoverBrush" Color="#33383C" />

    <!-- pulsante di testo (Annulla, Riprova, Rimuovi...) -->
    <Style x:Key="FtTextButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource BackgroundTextBrush}" />
        <Setter Property="FontSize" Value="{fpx:FontPx 12.5}" />
        <Setter Property="Padding" Value="8 4" />
        <Setter Property="Margin" Value="2 0 0 0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource FtRowHoverBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource FtRowHoverBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Carica in Desktop": un pulsante vero, con bordo e riquadro che si accende al passaggio del mouse -->
    <Style x:Key="FtChipButton" TargetType="Button" BasedOn="{StaticResource FtTextButton}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12 0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#2E2E2E" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource FtRowHoverBrush}" /><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentMidBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentMidBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- barra di avanzamento sottile (4 px) -->
    <Style x:Key="FtProgressBar" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource AccentMidBrush}" />
        <Setter Property="Background" Value="{StaticResource FtTrackBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="2" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- riga della coda: identica nel popup e nel navigatore -->
    <DataTemplate x:Key="FtJobRowTemplate">
        <Grid Margin="0 0 0 0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- riga 0: titolo, avanzamento e stato; riga 1: i pulsanti (sotto, cosi' il testo ha tutta la larghezza); riga 2: dettagli -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- direzione: freccia su (accento) = carica, freccia giu' (verde) = scarica -->
            <Border Grid.RowSpan="3" Width="28" Height="28" CornerRadius="4" VerticalAlignment="Top" Margin="0 2 12 0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource FtUploadBg}" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsUpload}" Value="False"><Setter Property="Background" Value="{StaticResource FtDownloadBg}" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="M 12,19 L 12,5 M 5,12 L 12,5 L 19,12" />
                            <Setter Property="Stroke" Value="{DynamicResource AccentMidBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUpload}" Value="False">
                                    <Setter Property="Data" Value="M 12,5 L 12,19 M 5,12 L 12,19 L 19,12" />
                                    <Setter Property="Stroke" Value="{StaticResource FtDownloadFg}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{fpx:FontPx 13.5}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" Style="{StaticResource TextBlockBase}" />
                    <TextBlock Text="{Binding SubTitle}" FontSize="{fpx:FontPx 12}" Margin="0 1 0 0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SubTitle}"
                               Foreground="#A8A8A8" Style="{StaticResource TextBlockBase}" />
                </StackPanel>
                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Margin="0 6 0 0" Visibility="{Binding ShowBar, Converter={StaticResource ConverterBool2Visible}}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource FtProgressBar}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Row}" Value="Done"><Setter Property="Foreground" Value="{StaticResource FtOkBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Row}" Value="Warn"><Setter Property="Foreground" Value="{StaticResource FtWarnBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Row}" Value="Waiting"><Setter Property="Foreground" Value="{StaticResource FtWarnBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Row}" Value="Failed"><Setter Property="Foreground" Value="{StaticResource FtErrBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Row}" Value="Scanning"><Setter Property="Opacity" Value="0.45" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Text="{Binding StatusText}" FontSize="{fpx:FontPx 12}" Margin="0 4 0 0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                            <Setter Property="Foreground" Value="#A8A8A8" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Row}" Value="Done"><Setter Property="Foreground" Value="{StaticResource FtOkBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Row}" Value="Warn"><Setter Property="Foreground" Value="{StaticResource FtWarnBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Row}" Value="Waiting"><Setter Property="Foreground" Value="{StaticResource FtWarnBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Row}" Value="Failed"><Setter Property="Foreground" Value="{StaticResource FtErrBrush}" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="-8 4 0 0">
                <Button Style="{StaticResource FtTextButton}" Content="{DynamicResource ft_cancel}" Command="{Binding CmdCancel}" Visibility="{Binding CanCancel, Converter={StaticResource ConverterBool2Visible}}" />
                <Button Style="{StaticResource FtTextButton}" Content="{DynamicResource ft_retry}" Command="{Binding CmdRetry}" Visibility="{Binding CanRetry, Converter={StaticResource ConverterBool2Visible}}" />
                <Button Style="{StaticResource FtTextButton}" Content="{DynamicResource ft_details}" Command="{Binding CmdDetails}" Visibility="{Binding CanDetails, Converter={StaticResource ConverterBool2Visible}}" />
                <Button Style="{StaticResource FtTextButton}" Content="{DynamicResource ft_show_destination}" Command="{Binding CmdShowDestination}" Visibility="{Binding CanShowDestination, Converter={StaticResource ConverterBool2Visible}}" />
                <Button Style="{StaticResource FtTextButton}" Content="{DynamicResource ft_remove}" Command="{Binding CmdRemove}" Visibility="{Binding CanRemove, Converter={StaticResource ConverterBool2Visible}}" />
            </WrapPanel>
            <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding DetailLines}" Margin="0 6 0 0" Visibility="{Binding ShowDetails, Converter={StaticResource ConverterBool2Visible}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" FontSize="{fpx:FontPx 12}" Foreground="#A8A8A8" TextWrapping="Wrap" Margin="0 2 0 0" Style="{StaticResource TextBlockBase}" /></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
