<UserControl x:Class="Lemora.View.FileTransfer.FileTransferPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lemora.View.FileTransfer"
             AllowDrop="True" Width="448">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FileTransferResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- popup della coda: si apre dal pulsante File; zona di rilascio + coda; sotto lo schermo non si disegna niente (e' una finestra a parte) -->
    <Border Margin="8" MaxHeight="520" Background="{DynamicResource PrimaryDarkBrush}" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="4">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.55" Color="Black" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- intestazione -->
            <Border Background="#262626" CornerRadius="4 4 0 0" Padding="14 0 8 0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource ft_title_caps}" FontSize="{fpx:FontPx 11.5}" FontWeight="SemiBold" Foreground="{DynamicResource AccentMidBrush}" VerticalAlignment="Center" Style="{StaticResource TextBlockBase}" />
                    <Button Grid.Column="1" HorizontalAlignment="Left" Margin="14 0 0 0" Style="{StaticResource FtChipButton}" Command="{Binding CmdChangeDestination}" ToolTip="{Binding DestinationPathText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource ft_upload_in}" Foreground="#C8C8C8" Style="{StaticResource TextBlockBase}" />
                            <TextBlock Text="{Binding DestinationName}" FontWeight="SemiBold" Margin="6 0 0 0" Foreground="{DynamicResource BackgroundTextBrush}" MaxWidth="120" TextTrimming="CharacterEllipsis" Style="{StaticResource TextBlockBase}" />
                            <Path Data="M 0,0 L 3.5,3.5 L 7,0" Stroke="#A8A8A8" StrokeThickness="1.4" Margin="8 1 0 0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Width="30" Height="26" Style="{StaticResource FtTextButton}" Command="{Binding CmdOpenNavigator}" ToolTip="{DynamicResource ft_open_navigator}">
                        <Path Data="M 3,9 L 3,3 L 9,3 M 13,17 L 13,23 L 7,23 M 3,3 L 10,10 M 13,23 L 6,16" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource BackgroundTextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <Button Grid.Column="3" Width="30" Height="26" Style="{StaticResource FtTextButton}" Command="{Binding CmdClosePopup}" ToolTip="{DynamicResource ft_close}">
                        <Path Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource BackgroundTextBrush}" StrokeThickness="1.6" />
                    </Button>
                </Grid>
            </Border>

            <!-- ultimo errore (l'avviso a comparsa dura pochi secondi): spiega il "!" sul pulsante -->
            <Border Grid.Row="1" Margin="16 16 16 0" Padding="12 10" CornerRadius="4" Background="#2A1A1A" BorderBrush="#FF9B94" BorderThickness="1"
                    Visibility="{Binding HasLastError, Converter={StaticResource ConverterBool2Visible}}">
                <TextBlock Text="{Binding LastError}" Foreground="#FF9B94" FontSize="{fpx:FontPx 12.5}" TextWrapping="Wrap" Style="{StaticResource TextBlockBase}" />
            </Border>

            <!-- zona di rilascio (normale / non disponibile) -->
            <Grid Grid.Row="2" Margin="16 16 16 6" x:Name="DropZone">
                <Rectangle RadiusX="4" RadiusY="4" StrokeThickness="1" StrokeDashArray="3 3">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Stroke" Value="#4A4A4A" />
                            <Setter Property="Fill" Value="#171717" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnavailable}" Value="True"><Setter Property="Stroke" Value="#FF9B94" /><Setter Property="Fill" Value="#2A1A1A" /></DataTrigger>
                                <DataTrigger Binding="{Binding Tag, ElementName=DropZone}" Value="Over"><Setter Property="Stroke" Value="{DynamicResource AccentMidBrush}" /><Setter Property="Fill" Value="#16313C" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                <StackPanel Margin="16 16" HorizontalAlignment="Center" Visibility="{Binding IsAvailableOrUnknown, Converter={StaticResource ConverterBool2Visible}}">
                    <Path Data="M 12,16 L 12,4 M 6,10 L 12,4 L 18,10 M 4,20 L 20,20" Width="26" Height="26" Stretch="Uniform" Stroke="{DynamicResource BackgroundTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource ft_drop_title}" FontWeight="SemiBold" FontSize="{fpx:FontPx 13.5}" HorizontalAlignment="Center" Margin="0 8 0 0" Style="{StaticResource TextBlockBase}" />
                    <TextBlock Text="{DynamicResource ft_drop_note}" Foreground="#A8A8A8" FontSize="{fpx:FontPx 12.5}" TextWrapping="Wrap" TextAlignment="Center" Margin="0 6 0 0" Style="{StaticResource TextBlockBase}" />
                    <Button Style="{StaticResource BtnSecondary}" Content="{DynamicResource ft_choose_files}" Command="{Binding CmdChooseFiles}" HorizontalAlignment="Center" Margin="0 12 0 0" Height="32" Padding="14 0" />
                </StackPanel>
                <StackPanel Margin="16 16" HorizontalAlignment="Center" Visibility="{Binding IsUnavailable, Converter={StaticResource ConverterBool2Visible}}">
                    <TextBlock Text="{Binding UnavailableTitle}" FontWeight="SemiBold" FontSize="{fpx:FontPx 14}" Foreground="#FF9B94" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource TextBlockBase}" />
                    <TextBlock Text="{Binding UnavailableText}" Foreground="#C8C8C8" FontSize="{fpx:FontPx 12.5}" TextWrapping="Wrap" TextAlignment="Center" Margin="0 8 0 0" Style="{StaticResource TextBlockBase}" />
                    <Button Style="{StaticResource BtnSecondary}" Content="{Binding UnavailableAction}" Command="{Binding CmdUnavailableAction}" HorizontalAlignment="Center" Margin="0 12 0 0" Height="32" Padding="14 0"
                            Visibility="{Binding HasUnavailableAction, Converter={StaticResource ConverterBool2Visible}}" />
                </StackPanel>
            </Grid>

            <!-- coda -->
            <ScrollViewer Grid.Row="3" Margin="16 6 8 6" MaxHeight="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasJobs, Converter={StaticResource ConverterBool2Visible}}">
                <ItemsControl ItemsSource="{Binding Jobs}" ItemTemplate="{StaticResource FtJobRowTemplate}" Margin="0 0 8 0">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0 0 0 14" /></Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="4" BorderThickness="0 1 0 0" BorderBrush="#303030" Padding="12 4" Visibility="{Binding HasFinished, Converter={StaticResource ConverterBool2Visible}}">
                <Button Style="{StaticResource FtTextButton}" HorizontalAlignment="Right" Content="{DynamicResource ft_clear_finished}" Command="{Binding CmdClearFinished}" />
            </Border>
        </Grid>
    </Border>
</UserControl>
