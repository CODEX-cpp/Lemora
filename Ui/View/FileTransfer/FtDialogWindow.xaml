<styles:WindowChromeBase x:Class="Lemora.View.FileTransfer.FtDialogWindow"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:styles="clr-namespace:Shawn.Utils.WpfResources.Theme.Styles;assembly=Shawn.Utils.WpfResources"
                         xmlns:controls="clr-namespace:Lemora.Controls"
                         xmlns:local="clr-namespace:Lemora.View.FileTransfer"
                         ShowInTaskbar="False" ResizeMode="NoResize" WindowStyle="None" SizeToContent="Height"
                         WindowStartupLocation="CenterOwner" Background="Transparent" Width="560" Title="Trasferimento file">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- scheda "Esistente" / "Nuovo" del conflitto: la piu' recente ha il bordo accento -->
        <DataTemplate DataType="{x:Type local:FtConflictCards}">
            <Grid Margin="0 18 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="14 12" BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource IslandBorderBrush}" Background="{DynamicResource IslandSubCardBrush}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ft_conflict_existing}" FontSize="{fpx:FontPx 11}" FontWeight="SemiBold" Foreground="{DynamicResource IslandSecondaryTextBrush}" Style="{StaticResource TextBlockBase}" />
                        <TextBlock Text="{Binding ExistingSize}" FontSize="{fpx:FontPx 16}" FontWeight="SemiBold" Margin="0 4 0 0" Style="{StaticResource TextBlockBase}" />
                        <TextBlock Text="{Binding ExistingDate}" Foreground="{DynamicResource IslandSecondaryTextBrush}" Style="{StaticResource TextBlockBase}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="14 12" BorderThickness="1" CornerRadius="4" Background="{DynamicResource IslandSubCardBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource IslandBorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NewIsNewer}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentMidBrush}" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ft_conflict_new}" FontSize="{fpx:FontPx 11}" FontWeight="SemiBold" Foreground="{DynamicResource AccentMidBrush}" Style="{StaticResource TextBlockBase}" />
                        <TextBlock Text="{Binding NewSize}" FontSize="{fpx:FontPx 16}" FontWeight="SemiBold" Margin="0 4 0 0" Style="{StaticResource TextBlockBase}" />
                        <TextBlock Text="{Binding NewDate}" Foreground="{DynamicResource IslandSecondaryTextBrush}" Style="{StaticResource TextBlockBase}" />
                        <TextBlock Text="{Binding NewTag}" Foreground="{DynamicResource AccentMidBrush}" Style="{StaticResource TextBlockBase}"
                                   Visibility="{Binding HasNewTag, Converter={StaticResource ConverterBool2Visible}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:FtRuleLine}">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0 12 0 0" Foreground="{DynamicResource IslandSecondaryTextBrush}" Style="{StaticResource TextBlockBase}" />
        </DataTemplate>
    </Window.Resources>

    <controls:DialogFrame Margin="40" Title="{Binding WindowTitle}" CanDragWindow="True" CloseCommand="{Binding CmdClose}">
        <controls:DialogFrame.Footer>
            <ItemsControl ItemsSource="{Binding Buttons}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- un pulsante per tipo (normale, primario, pericolo), visibile uno solo: lo stile non si puo' cambiare da un trigger -->
                        <Grid Margin="10 0 0 0">
                            <Button MinWidth="90" Style="{StaticResource BtnSecondary}" Content="{Binding Label}" Command="{Binding DataContext.CmdChoose, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                    Visibility="{Binding Normal, Converter={StaticResource ConverterBool2Visible}}" />
                            <Button MinWidth="90" Style="{StaticResource BtnPrimary}" Content="{Binding Label}" Command="{Binding DataContext.CmdChoose, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                    Visibility="{Binding Primary, Converter={StaticResource ConverterBool2Visible}}" />
                            <Button MinWidth="90" Style="{StaticResource BtnSecondary}" Content="{Binding Label}" Command="{Binding DataContext.CmdChoose, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                    Background="#FF9B94" Foreground="#3A0A07" FontWeight="SemiBold" Visibility="{Binding Danger, Converter={StaticResource ConverterBool2Visible}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </controls:DialogFrame.Footer>
        <StackPanel Margin="24 22 24 22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="15" VerticalAlignment="Top" Margin="0 0 14 0" Background="{Binding IconBrush}">
                    <TextBlock Text="{Binding IconGlyph}" FontWeight="Bold" FontSize="{fpx:FontPx 15}" Foreground="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource TextBlockBase}" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Heading}" FontSize="{fpx:FontPx 15}" FontWeight="SemiBold" TextWrapping="Wrap" Style="{StaticResource TextBlockBase}" />
                    <TextBlock Text="{Binding Message}" Margin="0 6 0 0" TextWrapping="Wrap" Foreground="{DynamicResource IslandSecondaryTextBrush}" Style="{StaticResource TextBlockBase}"
                               Visibility="{Binding HasMessage, Converter={StaticResource ConverterBool2Visible}}" />
                </StackPanel>
            </Grid>
            <ContentControl Content="{Binding Extra}" Focusable="False" />
            <TextBox Margin="0 14 0 0" MinHeight="36" VerticalContentAlignment="Center" Padding="8 0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding HasInput, Converter={StaticResource ConverterBool2Visible}}" x:Name="TbInput" />
            <TextBlock Margin="0 6 0 0" FontSize="{fpx:FontPx 12}" Foreground="#F28B82" Text="{Binding InputError}" Style="{StaticResource TextBlockBase}"
                       Visibility="{Binding HasInputError, Converter={StaticResource ConverterBool2Visible}}" />
            <CheckBox Margin="0 16 0 0" Content="{Binding CheckText}" IsChecked="{Binding IsChecked}" Visibility="{Binding HasCheck, Converter={StaticResource ConverterBool2Visible}}" />
        </StackPanel>
    </controls:DialogFrame>
</styles:WindowChromeBase>
