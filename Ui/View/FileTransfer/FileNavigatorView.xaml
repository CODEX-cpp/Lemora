<UserControl x:Class="Lemora.View.FileTransfer.FileNavigatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lemora.View.FileTransfer">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FileTransferResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- navigatore a pagina intera: sostituisce lo schermo (la barra sessione resta) -->
    <Grid Background="{DynamicResource BackgroundBrush}" DataContext="{Binding Navigator}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="176" />
        </Grid.RowDefinitions>
        <Border Margin="0 0 0 8" Padding="18 0 12 0" Background="{DynamicResource PrimaryDarkBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="0 0 0 1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource ft_navigator_title}" FontWeight="SemiBold" FontSize="{fpx:FontPx 16}" Style="{StaticResource TextBlockBase}" />
                    <TextBlock Text="{Binding Title}" Margin="14 0 0 0" Foreground="#A8A8A8" VerticalAlignment="Bottom" Style="{StaticResource TextBlockBase}" />
                </StackPanel>
                <Button Grid.Column="1" Margin="0 0 10 0" VerticalAlignment="Center" Style="{StaticResource FtChipButton}" Command="{Binding Vm.CmdChangeDestination}" ToolTip="{Binding Vm.DestinationPathText}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource ft_upload_in}" Foreground="#C8C8C8" Style="{StaticResource TextBlockBase}" />
                        <TextBlock Text="{Binding Vm.DestinationName}" FontWeight="SemiBold" Margin="6 0 0 0" Foreground="{DynamicResource BackgroundTextBrush}" Style="{StaticResource TextBlockBase}" />
                        <Path Data="M 0,0 L 3.5,3.5 L 7,0" Stroke="#A8A8A8" StrokeThickness="1.4" Margin="8 1 0 0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Height="30" Padding="14 0" VerticalAlignment="Center" Style="{StaticResource BtnSecondary}" Content="{DynamicResource ft_back_to_screen}" Command="{Binding Vm.CmdCloseNavigator}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="8 0 8 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:FilePaneView DataContext="{Binding Local}" />
            <Border Grid.Column="1" Margin="8 0" Background="{DynamicResource PrimaryDarkBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" CornerRadius="4">
                <StackPanel VerticalAlignment="Center" Margin="10">
                    <!-- "Carica" e' il pulsante primario solo quando a sinistra c'e' una selezione: due pulsanti sovrapposti, uno visibile per volta -->
                    <Grid Margin="0 0 0 8">
                        <Button Height="38" Style="{StaticResource BtnPrimary}" Content="{DynamicResource ft_act_upload}" Command="{Binding CmdUpload}" Visibility="{Binding CanUpload, Converter={StaticResource ConverterBool2Visible}}" />
                        <Button Height="38" Style="{StaticResource BtnSecondary}" Content="{DynamicResource ft_act_upload}" IsEnabled="False" Visibility="{Binding CanUpload, Converter={StaticResource ConverterBool2VisibleInv}}" />
                    </Grid>
                    <Button Height="38" Margin="0 0 0 8" Style="{StaticResource BtnSecondary}" Content="{DynamicResource ft_act_download}" Command="{Binding CmdDownload}" IsEnabled="{Binding CanDownload}" />
                    <Button Height="38" Margin="0 0 0 8" Style="{StaticResource BtnSecondary}" Content="{DynamicResource ft_act_rename}" Command="{Binding CmdRename}" IsEnabled="{Binding CanRename}" />
                    <Button Height="38" Margin="0 0 0 8" Style="{StaticResource BtnSecondary}" Content="{DynamicResource ft_act_delete}" Command="{Binding CmdDelete}" IsEnabled="{Binding CanDelete}" />
                    <Button Height="38" Style="{StaticResource BtnSecondary}" Content="{DynamicResource ft_act_newfolder}" Command="{Binding ActivePaneNewFolder}" />
                </StackPanel>
            </Border>
            <local:FilePaneView Grid.Column="2" DataContext="{Binding Remote}" />
        </Grid>

        <!-- coda -->
        <Border Grid.Row="2" Margin="8 0 8 8" Background="{DynamicResource PrimaryDarkBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" CornerRadius="4" DataContext="{Binding Vm}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="18 0 8 0">
                    <TextBlock Text="{DynamicResource ft_queue_title}" FontSize="{fpx:FontPx 11.5}" FontWeight="SemiBold" Foreground="{DynamicResource AccentMidBrush}" VerticalAlignment="Center" Style="{StaticResource TextBlockBase}" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource FtTextButton}" Content="{DynamicResource ft_clear_finished}" Command="{Binding CmdClearFinished}" Visibility="{Binding HasFinished, Converter={StaticResource ConverterBool2Visible}}" />
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="18 0 10 6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Jobs}" ItemTemplate="{StaticResource FtJobRowTemplate}">
                            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0 0 0 12" /></Style></ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                        <TextBlock Text="{DynamicResource ft_queue_empty}" Foreground="#7D7D7D" Margin="0 10 0 0" Style="{StaticResource TextBlockBase}" Visibility="{Binding HasJobs, Converter={StaticResource ConverterBool2VisibleInv}}" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
