<UserControl x:Class="Lemora.View.Launcher.ServerSelectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lemora.View.Launcher"
             xmlns:model="clr-namespace:Lemora.Model"
             xmlns:view="clr-namespace:Lemora.View"
             xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources"
             xmlns:s="https://github.com/canton7/Stylet"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance local:ServerSelectionsViewModel}"
             d:DesignHeight="450" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary  Source="LauncherDictionary.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SearchBoxTbKeyWordStyle" TargetType="TextBox" BasedOn="{StaticResource SearchBoxTbKeyWordStyleBase}" />

            <Style x:Key="LauncherSecondaryText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                <Setter Property="Foreground" Value="{DynamicResource IslandSecondaryTextBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <DataTemplate DataType="{x:Type view:ProtocolBaseViewModel}">
                <Grid Height="{x:Static view:LauncherWindowViewModel.LAUNCHER_SERVER_LIST_ITEM_HEIGHT}"
                      Width="{x:Static view:LauncherWindowViewModel.LAUNCHER_LIST_AREA_WIDTH}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />   <!-- sigla protocollo -->
                        <ColumnDefinition Width="*" />    <!-- nome + host -->
                        <ColumnDefinition Width="Auto" /> <!-- nota -->
                        <ColumnDefinition Width="Auto" /> <!-- utenti + cartella -->
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Margin="24 0 0 0" Text="{Binding ProtocolUpper}" Style="{StaticResource LauncherProtocolText}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ContentControl ToolTip="{Binding DisplayName}" s:View.Model="{Binding LauncherMainTitleViewModel}">
                            <ContentControl.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                    <Setter Property="FontSize" Value="{fpx:FontPx 15}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                </Style>
                            </ContentControl.Resources>
                        </ContentControl>
                        <TextBlock Text="{Binding HostText}" ToolTip="{Binding SubTitle}" Margin="0 1 0 0" FontSize="{fpx:FontPx 12.5}" Style="{StaticResource LauncherSecondaryText}" />
                    </StackPanel>

                    <!-- nota: si apre con la freccia sinistra -->
                    <Button Grid.Column="2" Background="Transparent" ToolTip="←"
                            attachProperty:VisionElement.BackgroundAccent="Transparent"
                            attachProperty:VisionElement.BackgroundOnMouseDown="Transparent"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 10 0"
                            attachProperty:VisionElement.Opacity="0.8"
                            attachProperty:VisionElement.OpacityAccent="0.9"
                            Visibility="{Binding Server.Note, Converter={StaticResource ConverterNoteToVisibility}}"
                            Tag="{Binding Server.Id}"
                            PreviewMouseDown="ButtonShowNote_OnClick"
                            Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=view:LauncherWindowView}, Path=DataContext.ServerSelectionsViewModel.CmdShowNoteField}"
                            Style="{StaticResource ButtonBarPrimaryStyle}"
                            IsEnabled="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=view:LauncherWindowView}, Path=DataContext.ServerSelectionsViewModel.IsShowNoteFieldEnabled}">
                        <Path Data="{StaticResource NoteGeometry}" Width="16" Height="16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                              StrokeThickness="0" Stretch="Uniform" />
                    </Button>

                    <!-- a destra: utenti e cartella -->
                    <StackPanel Grid.Column="3" Margin="0 0 20 0" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="170">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding UserText}" FontSize="{fpx:FontPx 12.5}" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}" Style="{StaticResource LauncherSecondaryText}" />
                            <TextBlock Text="{Binding ExtraUsersText}" FontSize="{fpx:FontPx 12.5}" Margin="8 0 0 0" Style="{StaticResource LauncherSecondaryText}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TagString}" FontSize="{fpx:FontPx 12}" TextAlignment="Right" Margin="0 1 0 0" ToolTip="{Binding TagString}" Style="{StaticResource LauncherSecondaryText}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource BackgroundBrush}">

        <!--servers list title-->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Name="GridKeyword"
                  Width="{x:Static view:LauncherWindowViewModel.LAUNCHER_LIST_AREA_WIDTH}" 
                  Height="{x:Static view:LauncherWindowViewModel.LAUNCHER_GRID_KEYWORD_HEIGHT}"
                  Background="{DynamicResource PrimaryMidBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- lente -->
                <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Stroke="{DynamicResource IslandSecondaryTextBrush}" StrokeThickness="1.6"
                      Data="M 6.5 1 A 5.5 5.5 0 1 0 6.5 12 A 5.5 5.5 0 1 0 6.5 1 M 10.5 10.5 L 15 15" />

                <TextBox Name="TbKeyWord" Grid.Column="1"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         PreviewKeyDown="TbKeyWord_OnPreviewKeyDown"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchBoxTbKeyWordStyle}"></TextBox>
                <TextBlock Grid.Column="1" Style="{StaticResource LauncherHintText}" Text="{DynamicResource launcher_search_hint}" />

                <!-- tag attivi -->
                <ItemsControl Grid.Column="2" VerticalAlignment="Center" Margin="0 0 8 0" ItemsSource="{Binding TagFilters}"
                              Visibility="{Binding TagFilters.Count, Converter={StaticResource ConverterEqual2Collapsed}, ConverterParameter='0'}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="model:TagFilter">
                            <Border VerticalAlignment="Center" Background="{DynamicResource IslandSelectedBrush}" CornerRadius="3" Margin="3 0" Padding="6 2">
                                <TextBlock Text="{Binding TagName}" ToolTip="{Binding TagName}" FontSize="{fpx:FontPx 12}" Foreground="{DynamicResource AccentMidBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- badge scorciatoia -->
                <Border Grid.Column="3" Margin="0 0 16 0" Padding="8 2" VerticalAlignment="Center" CornerRadius="3"
                        BorderBrush="{DynamicResource IslandButtonBorderBrush}" BorderThickness="1">
                    <TextBlock Text="Alt + M" FontSize="{fpx:FontPx 12}" Style="{StaticResource LauncherSecondaryText}" />
                </Border>

                <!-- filo accent sotto il campo -->
                <Border Grid.ColumnSpan="4" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource AccentMidBrush}" />
            </Grid>


            <!--servers list body-->
            <ListBox x:Name="ListBoxSelections"
                     Grid.Row="1"
                     Grid.IsSharedSizeScope="True"
                     BorderThickness="0"
                     PreviewMouseRightButtonDown="ListBoxSelections_OnMouseRightButtonDown"
                     PreviewMouseLeftButtonDown="ListBoxSelections_OnPreviewMouseLeftButtonDown"
                     SelectedIndex="{Binding SelectedIndex}"
                     ItemsSource="{Binding VmServerList}"
                     Style="{StaticResource SearchBoxSelectionList}">
            </ListBox>

        </Grid>


        <!--actions of selected server-->
        <Grid Name="GridActionsList" Visibility="Hidden" Background="{DynamicResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Width="{x:Static view:LauncherWindowViewModel.LAUNCHER_LIST_AREA_WIDTH}" 
                  Height="{x:Static view:LauncherWindowViewModel.LAUNCHER_GRID_KEYWORD_HEIGHT}"
                  Background="{DynamicResource PrimaryMidBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Background="Transparent" MouseDown="ButtonActionBack_OnMouseDown" Cursor="Hand">
                    <Path Width="9" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.8" Data="M 8 0 L 1 7.5 L 8 15" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0 0 16 0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ProtocolUpper}" Margin="0 0 10 0" FontSize="{fpx:FontPx 12}" Style="{StaticResource LauncherProtocolText}" DataContext="{Binding SelectedItem}" />
                        <TextBlock Style="{StaticResource TextBlockBase}" TextTrimming="CharacterEllipsis" FontSize="{fpx:FontPx 15}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding SelectedItem.Server.DisplayName}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource LauncherSecondaryText}" FontSize="{fpx:FontPx 12.5}" Text="{Binding SelectedItem.HostText}" />
                </StackPanel>
                <Border Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource AccentMidBrush}" />
            </Grid>

            <ListBox x:Name="ListBoxActions"
                     Grid.Row="1"
                     PreviewMouseRightButtonDown="ListBoxActions_OnMouseRightButtonDown"
                     PreviewMouseDoubleClick="ListBoxActions_OnMouseDoubleClick"
                     Style="{StaticResource SearchBoxActionList}"
                     BorderThickness="0"
                     SelectedIndex="{Binding SelectedActionIndex}"
                     ItemsSource="{Binding Actions}">
            </ListBox>
        </Grid>

    </Grid>
</UserControl>
