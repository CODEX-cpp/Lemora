<UserControl x:Class="Lemora.View.Launcher.QuickConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lemora.View.Launcher"
             xmlns:view="clr-namespace:Lemora.View"
             xmlns:model="clr-namespace:Lemora.Model"
             xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources"
             d:DataContext="{d:DesignInstance local:QuickConnectionViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary  Source="LauncherDictionary.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SearchBoxTbKeyWordStyle" TargetType="TextBox" BasedOn="{StaticResource SearchBoxTbKeyWordStyleBase}" />

            <DataTemplate DataType="{x:Type local:QuickConnectionItem}">
                <Grid Height="{x:Static view:LauncherWindowViewModel.LAUNCHER_SERVER_LIST_ITEM_HEIGHT}" Width="{x:Static view:LauncherWindowViewModel.LAUNCHER_LIST_AREA_WIDTH}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- riga primaria (nessun protocollo): "Connetti a ..." -->
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding Host}" FontSize="{fpx:FontPx 15}" FontWeight="SemiBold" Margin="24 0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource AccentMidBrush}" VerticalAlignment="Center" Style="{StaticResource TextBlockBase}">
                        <TextBlock.Visibility>
                            <Binding Path="Protocol" Converter="{StaticResource ConverterEqual2Collapsed}" ConverterParameter="" />
                        </TextBlock.Visibility>
                    </TextBlock>

                    <!-- cronologia -->
                    <TextBlock Grid.Column="0" Margin="24 0 0 0" Text="{Binding Protocol}" FontSize="{fpx:FontPx 13}" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource ProtocolOtherBrush}" Style="{StaticResource TextBlockBase}">
                        <TextBlock.Visibility>
                            <Binding Path="Protocol" Converter="{StaticResource ConverterEqual2Visible}" ConverterParameter="" />
                        </TextBlock.Visibility>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding Host}" FontSize="{fpx:FontPx 15}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Style="{StaticResource TextBlockBase}">
                        <TextBlock.Visibility>
                            <Binding Path="Protocol" Converter="{StaticResource ConverterEqual2Visible}" ConverterParameter="" />
                        </TextBlock.Visibility>
                    </TextBlock>

                    <Button Grid.Column="2" Width="24" Height="24" Margin="0 0 16 0" Background="Transparent" Cursor="Hand"
                            attachProperty:VisionElement.Opacity="0.6"
                            attachProperty:VisionElement.OpacityAccent="1"
                            attachProperty:VisionElement.BackgroundAccent="Transparent"
                            Tag="{Binding}"
                            PreviewMouseLeftButtonUp="ButtonDeleteItem_OnClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ButtonBarAccentStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Protocol}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Width="9" Height="9" Stretch="Uniform"
                              Data="F1 M 47.910156 -44.000000 L 87.183594 -4.683594 L 83.316406 -0.816406 L 44.000000 -40.089844 L 4.683594 -0.816406 L 0.816406 -4.683594 L 40.089844 -44.000000 L 0.816406 -83.316406 L 4.683594 -87.183594 L 44.000000 -47.910156 L 83.316406 -87.183594 L 87.183594 -83.316406 Z "
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                              StrokeThickness="2" />
                    </Button>
                </Grid>
            </DataTemplate>



            <Style x:Key="ListBoxItemStyleForQuickConnect" TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemStyleForServer}" />

            <Style x:Key="ListQuickConnect" TargetType="{x:Type ListBox}" BasedOn="{StaticResource SearchBoxSelectionList}">
                <Setter Property="ItemContainerStyle" Value="{StaticResource ListBoxItemStyleForQuickConnect}"></Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Name="GridKeyword" Height="{x:Static view:LauncherWindowViewModel.LAUNCHER_GRID_KEYWORD_HEIGHT}" Background="{DynamicResource PrimaryMidBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <ComboBox TabIndex="1" Margin="12 10 4 10" MinWidth="96" IsTabStop="False" Grid.Column="0"
                      DisplayMemberPath="Protocol"
                      SelectedItem="{Binding SelectedProtocol}"
                      ItemsSource="{Binding Protocols}">
            </ComboBox>

            <TextBox Name="TbKeyWord" Grid.Column="1" Margin="8 0 0 0"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     PreviewKeyDown="TbKeyWord_OnPreviewKeyDown"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource SearchBoxTbKeyWordStyle}" />
            <TextBlock Grid.Column="1" Margin="8 0 0 0" Style="{StaticResource LauncherHintText}" Text="{DynamicResource launcher_quick_hint}" />

            <Border Grid.Column="2" Margin="0 0 16 0" Padding="8 2" VerticalAlignment="Center" CornerRadius="3"
                    BorderBrush="{DynamicResource IslandButtonBorderBrush}" BorderThickness="1">
                <TextBlock Text="Tab" FontSize="{fpx:FontPx 12}" Foreground="{DynamicResource IslandSecondaryTextBrush}" Style="{StaticResource TextBlockBase}" />
            </Border>
            <Border Grid.ColumnSpan="3" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource AccentMidBrush}" />
        </Grid>

        <ListBox x:Name="ListBoxHistory"
                 Grid.Row="1"
                 BorderThickness="0"
                 PreviewMouseLeftButtonDown="ListBoxHistory_OnPreviewMouseLeftButtonDown"
                 SelectedIndex="{Binding SelectedIndex}"
                 ItemsSource="{Binding ConnectHistory}"
                 Style="{StaticResource ListQuickConnect}"
                 >
        </ListBox>
    </Grid>
</UserControl>
