<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:model="clr-namespace:Lemora.Model"
                    xmlns:view="clr-namespace:Lemora.View"
                    xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources"
                    xmlns:converter="clr-namespace:Shawn.Utils.WpfResources.Converter;assembly=Shawn.Utils.WpfResources">

    <converter:ConverterColorHexString2Brush x:Key="ConverterColorHexString2Brush"></converter:ConverterColorHexString2Brush>





    <Style x:Key="SearchBoxTbKeyWordStyleBase" TargetType="TextBox"  BasedOn="{StaticResource TextBoxBaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentMidBrush}" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="TabIndex" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="56" />
        <Setter Property="FontSize" Value="{fpx:FontPx 17}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="AllowDrop" Value="true" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- suggerimento del campo di ricerca: visibile solo a campo vuoto -->
    <Style x:Key="LauncherHintText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
        <Setter Property="Foreground" Value="{DynamicResource IslandSecondaryTextBrush}" />
        <Setter Property="FontSize" Value="{fpx:FontPx 17}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=TbKeyWord}" Value="">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- sigla protocollo: solo testo colorato -->
    <Style x:Key="LauncherProtocolText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
        <Setter Property="FontSize" Value="{fpx:FontPx 13}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource ProtocolOtherBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Server.ProtocolDisplayName}" Value="RDP"><Setter Property="Foreground" Value="{DynamicResource ProtocolRdpBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Server.ProtocolDisplayName}" Value="RemoteApp"><Setter Property="Foreground" Value="{DynamicResource ProtocolRdpBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Server.ProtocolDisplayName}" Value="SSH"><Setter Property="Foreground" Value="{DynamicResource ProtocolSshBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Server.ProtocolDisplayName}" Value="VNC"><Setter Property="Foreground" Value="{DynamicResource ProtocolVncBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Server.ProtocolDisplayName}" Value="SFTP"><Setter Property="Foreground" Value="{DynamicResource ProtocolSftpBrush}" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- riga selezionata: fondo chiaro + barra accent 3px a sinistra -->
    <Style x:Key="ListBoxItemStyleForServer" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="GridHighLight" />
                        <Border x:Name="SelBar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource AccentMidBrush}" Visibility="Collapsed" />
                        <ContentPresenter x:Name="ContentPresenter"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="GridHighLight" Value="{DynamicResource IslandHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" TargetName="GridHighLight" Value="{DynamicResource PrimaryLightBrush}" />
                            <Setter TargetName="SelBar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchBoxSelectionList" TargetType="{x:Type ListBox}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="0" SnapsToDevicePixels="true">
                        <ScrollViewer Focusable="false" Padding="{TemplateBinding Padding}" 
                                      Background="{DynamicResource BackgroundBrush}"
                                      attachProperty:VisionElement.ForegroundAccent="{DynamicResource PrimaryTextBrush}"
                                      attachProperty:VisionElement.BackgroundAccent="{DynamicResource PrimaryTextBrush}"
                                      Style="{StaticResource ScrollViewAccentStyle}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ListBoxItemStyleForServer}"></Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel IsVirtualizing="True"
                                            ScrollUnit="Pixel"
                                            VirtualizationMode="Recycling"
                                            CacheLengthUnit="Item"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <Style x:Key="TextBlockDataTemplateForProtocolActionStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
        <Setter Property="Opacity" Value="1"></Setter>
        <Setter Property="FontSize" Value="{fpx:FontPx 14}"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"></Setter>
        <Setter Property="Margin" Value="5 0 10 0"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"></Setter>
    </Style>


    <DataTemplate x:Key="DataTemplateForProtocolAction" DataType="model:ProtocolAction">
        <Grid Height="{x:Static view:LauncherWindowViewModel.LAUNCHER_ACTION_LIST_ITEM_HEIGHT}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"></ColumnDefinition>
                    <ColumnDefinition Width="0"></ColumnDefinition>
                    <ColumnDefinition Width="0"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" 
                           Grid.Column="3" 
                           Text="{Binding ActionName}"
                           Style="{StaticResource TextBlockDataTemplateForProtocolActionStyle}">
                </TextBlock>
            </Grid>
        </Grid>
    </DataTemplate>


    <Style x:Key="ListBoxItemStyleForAction" TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemStyleForServer}" />

    <Style x:Key="SearchBoxActionList" TargetType="{x:Type ListBox}" BasedOn="{StaticResource SearchBoxSelectionList}">
        <Setter Property="ItemTemplate" Value="{StaticResource DataTemplateForProtocolAction}"></Setter>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ListBoxItemStyleForAction}"></Setter>
    </Style>
</ResourceDictionary>