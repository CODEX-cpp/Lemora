<styles:WindowChromeBase x:Class="Lemora.View.ErrorReport.ErrorReportWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ctl="clr-namespace:Lemora.Controls"
                  xmlns:styles="clr-namespace:Shawn.Utils.WpfResources.Theme.Styles;assembly=Shawn.Utils.WpfResources"
                  mc:Ignorable="d"
                  WindowStartupLocation="CenterScreen"
                  ResizeMode="NoResize"
                  WindowStyle="None"
                  Background="Transparent"
                  Title="Lemora" Height="680" Width="880">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <!-- finestra errore (blueprint §12): icona rossa + titolo, rapporto in blocco monospazio scorrevole, azioni sotto -->
    <ctl:DialogFrame Margin="40" Title="Lemora" CanDragWindow="True">
        <Grid Margin="24 20 24 22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Name="WinGrid" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ctl:DialogIcon Kind="Error" Width="40" Height="40" Margin="0 0 16 0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextBlockBase}" FontSize="{fpx:FontPx 22}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{DynamicResource word_oops}" />
                </StackPanel>
            </Grid>

            <TextBox Name="TbErrorInfo" Grid.Row="1" Margin="0 14 0 14"
                     AcceptsReturn="True" AcceptsTab="True" IsReadOnly="True"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                     FontFamily="Cascadia Mono, Consolas" FontSize="{fpx:FontPx 12.5}" Padding="12"
                     Text="Error test message" />

            <StackPanel Grid.Row="2">
                <TextBlock Style="{StaticResource TextBlockBase}" TextWrapping="Wrap" Foreground="{DynamicResource IslandSecondaryTextBrush}" Margin="0 0 0 12"
                           Text="{DynamicResource error_report_unexpected_error_occurred}" />
                <TextBlock Style="{StaticResource TextBlockBase}" TextWrapping="Wrap" Foreground="{DynamicResource IslandSecondaryTextBrush}" Margin="0 0 0 14"
                           Text="{DynamicResource error_report_please_help_us_improve}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BtnPrimary}" Padding="18 0" Click="ButtonCopyToClipboard_OnClick" Content="{DynamicResource error_report_to_clipboard}" />
                        <Path Name="IconCopyDone" Width="14" Height="14" Margin="8 0 0 0" Stretch="Uniform" Fill="#6CCB5F" VerticalAlignment="Center"
                              Data="M512 0C230.4 0 0 230.4 0 512s230.4 512 512 512 512-230.4 512-512S793.6 0 512 0zM409.6 761.6l-236.8-217.6L230.4 480 409.6 640 793.6 256l64 64L409.6 761.6z" />
                        <Button Style="{StaticResource BtnSecondary}" Margin="10 0 0 0" Padding="18 0" Click="ButtonSaveAs_OnClick" Content="{DynamicResource 'Save as...'}" />
                        <Path Name="IconSaveDone" Width="14" Height="14" Margin="8 0 0 0" Stretch="Uniform" Fill="#6CCB5F" VerticalAlignment="Center"
                              Data="M512 0C230.4 0 0 230.4 0 512s230.4 512 512 512 512-230.4 512-512S793.6 0 512 0zM409.6 761.6l-236.8-217.6L230.4 480 409.6 640 793.6 256l64 64L409.6 761.6z" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ctl:DialogFrame>
</styles:WindowChromeBase>
