<UserControl x:Class="Lemora.View.Settings.DataSource.DataSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Lemora.View.Settings.DataSource"
             xmlns:dataSource="clr-namespace:Lemora.Service.DataSource"
             xmlns:dao="clr-namespace:Lemora.Service.DataSource.DAO"
             xmlns:controls="clr-namespace:Shawn.Utils.Wpf.Controls;assembly=Shawn.Utils.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:DataSourceViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="840" HorizontalAlignment="Stretch" Margin="32 24 32 32">

                <!-- titolo + Aggiungi -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SettingPageTitle}" VerticalAlignment="Center" Text="{DynamicResource system_options_data_security_database}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="CbAddSource" Style="{x:Null}" Cursor="Hand" Focusable="False" FocusVisualStyle="{x:Null}" Height="34">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border x:Name="Bd" Background="{DynamicResource AccentMidBrush}" CornerRadius="{StaticResource IslandRadius}" Padding="16 0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeometryCross}" Stretch="Uniform" Width="12" Height="12" Fill="{DynamicResource AccentTextBrush}" />
                                            <TextBlock Text="{DynamicResource Add}" Margin="10 0 0 0" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                                            <Path Data="M 0,0 L 7,0 L 3.5,4.5 Z" Fill="{DynamicResource AccentTextBrush}" Margin="10 1 0 0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>
                        <Popup IsOpen="{Binding ElementName=CbAddSource, Path=IsChecked}" StaysOpen="False" AllowsTransparency="True" Placement="Bottom"
                               PlacementTarget="{Binding ElementName=CbAddSource}">
                            <Border Margin="0 4 0 0" Padding="4" MinWidth="170" Background="{DynamicResource PrimaryDarkBrush}"
                                    BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource IslandRadius}">
                                <StackPanel>
                                    <Button Style="{StaticResource BtnNav}" Height="32" HorizontalContentAlignment="Left" Content="MySQL"
                                            Command="{Binding CmdAdd}" CommandParameter="MySQL" Click="AddSourceItem_OnClick" />
                                    <Button Style="{StaticResource BtnNav}" Height="32" HorizontalContentAlignment="Left" Content="PostgreSQL"
                                            Command="{Binding CmdAdd}" CommandParameter="PostgreSQL" Click="AddSourceItem_OnClick" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource TextBlockBase}" Margin="0 10 0 0" TextWrapping="Wrap" Foreground="{DynamicResource IslandSecondaryTextBrush}">
                    <Run Text="{DynamicResource settings_data_intro}" />
                </TextBlock>

                <!-- tabella origini dati -->
                <Border Margin="0 18 0 0" BorderThickness="1" BorderBrush="{DynamicResource IslandBorderBrush}" CornerRadius="{StaticResource IslandRadius}"
                        Background="{DynamicResource IslandSubCardBrush}" ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding SourceConfigs}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14 10" BorderThickness="0 0 0 1" BorderBrush="{DynamicResource IslandDividerBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- stato: icona cliccabile per ricollegare -->
                                        <Button Margin="0 0 12 0" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:DataSourceView}, Path=DataContext.CmdRefreshDataSource}"
                                                CommandParameter="{Binding}" ToolTip="{Binding StatusInfo}" Style="{x:Null}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource IslandRadius}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IslandHoverBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <!-- verde = connessa, rosso = non connessa -->
                                            <Ellipse Width="10" Height="10">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#F28B82" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static dao:EnumDatabaseStatus.OK}">
                                                                <Setter Property="Fill" Value="#81C995" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Button>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource TextBlockBase}" FontWeight="SemiBold" Text="{Binding DataSourceName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource TextBlockBase}" Foreground="{DynamicResource IslandSecondaryTextBrush}" Text=" (Readonly)"
                                                       Visibility="{Binding IsWritable, Converter={StaticResource ConverterBool2VisibleInv}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource TextBlockBase}" VerticalAlignment="Center" Foreground="{DynamicResource IslandSecondaryTextBrush}" Text="{Binding DatabaseType}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource TextBlockBase}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="{fpx:FontPx 12.5}"
                                                   TextTrimming="CharacterEllipsis" Text="{Binding Description}" ToolTip="{Binding Description}" />

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource BtnSecondary}" Height="30" Padding="12 0" Margin="8 0 0 0" Content="{DynamicResource Edit}"
                                                    Command="{Binding Path=DataContext.CmdEdit, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                                            <Button Height="30" Padding="12 0" Margin="8 0 0 0" Content="{DynamicResource Delete}"
                                                    Command="{Binding Path=DataContext.CmdDelete, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BtnDanger}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataSourceName}" Value="{x:Static dataSource:DataSourceService.LOCAL_DATA_SOURCE_NAME}">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
