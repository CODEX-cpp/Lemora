<UserControl x:Class="Lemora.View.Settings.Mcp.McpSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Lemora.View.Settings.Mcp"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:McpSettingViewModel}"
             d:DesignHeight="800" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="840" HorizontalAlignment="Stretch" Margin="32 24 32 32">
                <TextBlock Style="{StaticResource SettingPageTitle}" Text="{DynamicResource mcp_server_title}" />
                <TextBlock Margin="0 10 0 0" TextWrapping="Wrap" Style="{StaticResource TextBlockBase}" Foreground="{DynamicResource IslandSecondaryTextBrush}"
                           Text="{DynamicResource mcp_page_intro}" />

                <!-- full block decided by the Teams administrator -->
                <Border Margin="0 14 0 0" Padding="14 10" CornerRadius="{StaticResource IslandRadius}" BorderThickness="1"
                        Background="{DynamicResource IslandSubCardBrush}" BorderBrush="{DynamicResource AccentMidBrush}"
                        Visibility="{Binding Locked, Converter={StaticResource BoolToVis}}">
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource TextBlockBase}" Text="{Binding LockText}" />
                </Border>

                <TextBlock Style="{StaticResource SettingSection}" Text="{DynamicResource mcp_section_server}" />
                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{DynamicResource mcp_enable_header}" Tag="{Binding StatusText}">
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="McpEnabled" />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{DynamicResource Port}" Tag="{DynamicResource mcp_port_hint}">
                    <TextBox Width="90" Height="32" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" IsEnabled="{Binding CanEdit}"
                             Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.AutomationId="McpPort" />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{DynamicResource mcp_token_header}" Tag="{DynamicResource mcp_token_hint}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BtnSecondary}" Height="30" Padding="12 0" Content="{Binding ShowTokenLabel}" Command="{Binding CmdShowToken}" />
                        <Button Style="{StaticResource BtnSecondary}" Height="30" Padding="12 0" Margin="8 0 0 0" Content="{DynamicResource Copy}" Command="{Binding CmdCopyToken}" />
                        <Button Style="{StaticResource BtnSecondary}" Height="30" Padding="12 0" Margin="8 0 0 0" Content="{DynamicResource mcp_regen_button}" Command="{Binding CmdRegenerate}" IsEnabled="{Binding CanEdit}" />
                    </StackPanel>
                </HeaderedContentControl>
                <TextBox Margin="0 6 0 0" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" Foreground="{DynamicResource IslandSecondaryTextBrush}"
                         Text="{Binding TokenText, Mode=OneWay}" />
                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{DynamicResource mcp_banner_header}"
                                        Tag="{DynamicResource mcp_banner_hint}">
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BannerEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="McpBanner" />
                </HeaderedContentControl>

                <TextBlock Style="{StaticResource SettingSection}" Text="{DynamicResource mcp_section_link}" />
                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{DynamicResource mcp_link_header}" Tag="{Binding ClaudeLinkText}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BtnPrimary}" Height="30" Padding="14 0" Content="{DynamicResource mcp_link_button}" Command="{Binding CmdLinkClaude}" AutomationProperties.AutomationId="McpLink" />
                        <Button Height="30" Padding="12 0" Margin="8 0 0 0" Content="{DynamicResource mcp_unlink_button}" Command="{Binding CmdUnlinkClaude}" AutomationProperties.AutomationId="McpUnlink">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClaudeLinked}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </HeaderedContentControl>
                <TextBlock Margin="0 8 0 0" TextWrapping="Wrap" Style="{StaticResource TextBlockBase}" FontSize="{fpx:FontPx 12}" Foreground="{DynamicResource IslandSecondaryTextBrush}"
                           Text="{DynamicResource mcp_cli_hint}" />
                <Grid Margin="0 6 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="10 8" CornerRadius="{StaticResource IslandRadius}" Background="{DynamicResource IslandSubCardBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1">
                        <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" FontFamily="Consolas" Text="{Binding CommandText, Mode=OneWay}" />
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Height="30" Padding="12 0" Margin="8 0 0 0" VerticalAlignment="Center" Content="{DynamicResource Copy}" Command="{Binding CmdCopyCommand}" />
                </Grid>

                <TextBlock Style="{StaticResource SettingSection}" Text="{DynamicResource mcp_section_what}" />
                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{DynamicResource mcp_vnc_header}"
                                        Tag="{DynamicResource mcp_vnc_hint}">
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AllowVnc, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="McpVnc" />
                </HeaderedContentControl>
                <TextBlock Margin="0 14 0 0" Style="{StaticResource TextBlockBase}" FontWeight="SemiBold" Text="{DynamicResource mcp_rdp_title}" />
                <TextBlock Margin="0 4 0 0" TextWrapping="Wrap" Style="{StaticResource TextBlockBase}" Foreground="{DynamicResource IslandSecondaryTextBrush}"
                           Text="{DynamicResource mcp_rdp_hint}" />
                <TextBox Margin="0 10 0 0" Height="34" Tag="{DynamicResource mcp_filter_placeholder}" Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="McpFilter" />
                <Border Margin="0 8 0 0" Padding="8 6" BorderThickness="1" BorderBrush="{DynamicResource IslandBorderBrush}" CornerRadius="{StaticResource IslandRadius}"
                        Background="{DynamicResource IslandSubCardBrush}" IsEnabled="{Binding CanEdit}">
                    <StackPanel>
                        <TreeView ItemsSource="{Binding Nodes}" BorderThickness="0" Background="Transparent" MaxHeight="460" AutomationProperties.AutomationId="McpTree">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="True" />
                                    <Setter Property="Visibility" Value="{Binding Visibility}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0 3">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanChange}" VerticalAlignment="Center" />
                                        <TextBlock Margin="8 0 0 0" VerticalAlignment="Center" Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBold}" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="8 0 0 0" Style="{StaticResource TextBlockBase}" VerticalAlignment="Center" FontSize="{fpx:FontPx 12}"
                                                   Foreground="{DynamicResource IslandSecondaryTextBrush}" Text="{Binding Detail}" />
                                        <TextBlock Margin="8 0 0 0" Style="{StaticResource TextBlockBase}" VerticalAlignment="Center" FontSize="{fpx:FontPx 12}" FontStyle="Italic"
                                                   Foreground="{DynamicResource IslandSecondaryTextBrush}" Text="{Binding Note}" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <Border Margin="0 6 0 0" Padding="4 8 0 4" BorderThickness="0 1 0 0" BorderBrush="{DynamicResource IslandDividerBrush}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding AllowAddresses, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.AutomationId="McpAddresses" />
                                <TextBlock Margin="8 0 0 0" Style="{StaticResource TextBlockBase}" FontWeight="SemiBold" VerticalAlignment="Center" Text="{DynamicResource mcp_addresses_title}" />
                                <TextBlock Margin="8 0 0 0" Style="{StaticResource TextBlockBase}" VerticalAlignment="Center" FontSize="{fpx:FontPx 12}"
                                           Foreground="{DynamicResource IslandSecondaryTextBrush}" Text="{DynamicResource mcp_addresses_hint}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
