<UserControl x:Class="Lemora.View.Settings.ProtocolConfig.ProtocolRunnerSettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources"
             xmlns:protocolConfig="clr-namespace:Lemora.View.Settings.ProtocolConfig"
             xmlns:default="clr-namespace:Lemora.Model.ProtocolRunner.Default"
             xmlns:runner="clr-namespace:Lemora.Model.ProtocolRunner"
             xmlns:controls="clr-namespace:Shawn.Utils.Wpf.Controls;assembly=Shawn.Utils.Wpf"
             d:DataContext="{d:DesignInstance protocolConfig:ProtocolRunnerSettingsPageViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ProtocolConfiogDictionary.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <protocolConfig:NameEqualsConverter x:Key="NameEquals" />

            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                <Setter Property="Foreground" Value="{DynamicResource BackgroundTextBrush}"></Setter>
            </Style>

            <Style x:Key="ListBoxForProtocols" TargetType="{x:Type ListBox}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Margin="10 3" Cursor="Hand">
                                            <Border x:Name="GridContainer" CornerRadius="5" 
                                                    BorderBrush="{DynamicResource DefaultBorderBrush}" BorderThickness="1">
                                            </Border>
                                            <ContentPresenter x:Name="ContentPresenter"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="GridContainer" Value="{DynamicResource PrimaryTextBrush}"></Setter>
                                                <Setter Property="Opacity" Value="0.2" TargetName="GridContainer" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Opacity" Value="1" TargetName="GridContainer" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" TargetName="ContentPresenter" />
                                                <Setter Property="Background" Value="{DynamicResource AccentMidBrush}" TargetName="GridContainer" />
                                                <Setter Property="BorderThickness" Value="0" TargetName="GridContainer" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource AccentMidBrush}"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Grid Margin="10">
                                <TextBlock Text="{Binding}"></TextBlock>
                            </Grid>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ListBoxRunners" TargetType="{x:Type ListBox}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Margin="0 0 5 0">
                                            <Border x:Name="GridContainer"></Border>
                                            <ContentPresenter x:Name="ContentPresenter"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>



            <DataTemplate DataType="{x:Type default:InternalDefaultRunner}">
                <Grid Style="{StaticResource Block}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Border Name="Border1" Grid.Row="0" Grid.RowSpan="2" 
                            Background="{DynamicResource IslandSubCardBrush}"
                            CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource IslandBorderBrush}">
                    </Border>
                    <Grid Grid.Row="0" Background="Transparent" Margin="16 10 8 4">
                        <TextBlock HorizontalAlignment="Left"  VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}" 
                                   FontSize="{fpx:FontPx 15}" FontWeight="SemiBold" 
                                   Text="{Binding Name}" Margin="0"></TextBlock>
                    </Grid>
                    <Grid Grid.Row="1" MinHeight="50">
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16 0 0 12" Foreground="{DynamicResource IslandSecondaryTextBrush}" Text="{DynamicResource settings_runner_builtin_note}"></TextBlock>
                    </Grid>
                </Grid>
            </DataTemplate>







            <!-- terminale SSH integrato: nessun programma esterno, solo il pulsante per le sue impostazioni -->
            <DataTemplate DataType="{x:Type default:TerminalRunner}">
                <Grid Style="{StaticResource Block}">
                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource IslandBorderBrush}" Background="{DynamicResource IslandSubCardBrush}" />
                    <Grid Margin="16 12 16 14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="{fpx:FontPx 15}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{DynamicResource settings_runner_terminal_title}" VerticalAlignment="Center" />
                                <!-- etichetta: compare quando e' il programma scelto per questo protocollo -->
                                <Border Margin="10 0 0 0" Padding="8 1" CornerRadius="3" Background="{DynamicResource AccentMidBrush}" VerticalAlignment="Center">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource NameEquals}">
                                            <Binding Path="Name" />
                                            <Binding Path="DataContext.SelectedRunner.Name" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </Border.Visibility>
                                    <TextBlock Text="{DynamicResource settings_runner_default_badge}" FontSize="{fpx:FontPx 12}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="0 5 0 0" TextWrapping="Wrap" Foreground="{DynamicResource IslandSecondaryTextBrush}"
                                       Text="{DynamicResource settings_runner_terminal_desc}" />
                        </StackPanel>
                        <Button Grid.Column="1" Margin="16 0 0 0" Height="34" Padding="14 0" VerticalAlignment="Center" Style="{StaticResource BtnSecondary}" Click="TerminalSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconGear}" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.6" Stroke="{DynamicResource AccentMidBrush}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <TextBlock Margin="8 0 0 0" Foreground="{DynamicResource AccentMidBrush}" Text="{DynamicResource settings_runner_terminal_settings}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type default:KittyRunner}">
                <protocolConfig:KittyRunnerSettings Runner="{Binding}"></protocolConfig:KittyRunnerSettings>
            </DataTemplate>


            <DataTemplate DataType="{x:Type default:PuttyRunner}">
                <protocolConfig:PuttyRunnerSettings Runner="{Binding}"></protocolConfig:PuttyRunnerSettings>
            </DataTemplate>

            <protocolConfig:ConverterExternalRunner2Vm x:Key="ExternalRunner2Vm"></protocolConfig:ConverterExternalRunner2Vm>



            <DataTemplate DataType="{x:Type runner:ExternalRunnerForSSH}">
                <protocolConfig:ExternalSshRunnerSettings DataContext="{Binding Path=., Converter={StaticResource ExternalRunner2Vm}}"></protocolConfig:ExternalSshRunnerSettings>
            </DataTemplate>


            <DataTemplate DataType="{x:Type runner:ExternalRunner}">
                <protocolConfig:ExternalRunnerSettings DataContext="{Binding Path=., Converter={StaticResource ExternalRunner2Vm}}"></protocolConfig:ExternalRunnerSettings>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="840" HorizontalAlignment="Stretch" Margin="32 24 32 32">
                <TextBlock Style="{StaticResource SettingPageTitle}" Text="{DynamicResource settings_nav_protocol}" />
                <TextBlock Margin="0 8 0 18" TextWrapping="Wrap" Foreground="{DynamicResource IslandSecondaryTextBrush}" Text="{DynamicResource settings_runner_intro}" />

                <!-- un solo protocollo alla volta -->
                <ListBox Style="{StaticResource SegmentedListBox}" ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}" />

                <!-- programma predefinito + aggiungi -->
                <Grid Margin="0 18 0 16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 14 0">
                        <TextBlock Text="{DynamicResource settings_runner_default_for}" Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                        <TextBlock Text="{Binding SelectedProtocol}" Margin="5 0 0 0" Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="260"
                              ItemsSource="{Binding Runners, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedRunner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="3" Height="34" Padding="14 0" Style="{StaticResource BtnSecondary}" Command="{Binding CmdAddRunner}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeometryCross}" Stretch="Uniform" Width="11" Height="11" Fill="{DynamicResource AccentMidBrush}" />
                            <TextBlock Margin="8 0 0 0" Foreground="{DynamicResource AccentMidBrush}" Text="{DynamicResource settings_runner_add}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ListBox ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         Style="{StaticResource ListBoxRunners}" Grid.IsSharedSizeScope="True"
                         ItemsSource="{Binding Runners}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
