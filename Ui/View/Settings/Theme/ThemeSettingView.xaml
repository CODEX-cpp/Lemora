<UserControl x:Class="Lemora.View.Settings.Theme.ThemeSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Lemora.View.Settings.Theme"
             xmlns:colorPickerWpf="clr-namespace:ColorPickerWPF;assembly=Shawn.Utils.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ThemeSettingViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- anteprima del tema: fondo, pannello, accento + nome; selezionato = bordo accento -->
        <Style x:Key="ThemeCardItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0 0 12 12" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Width="170" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource IslandBorderBrush}"
                                Background="{DynamicResource IslandSubCardBrush}" CornerRadius="{StaticResource IslandRadius}">
                            <StackPanel>
                                <Border Height="56" CornerRadius="3" Background="{Binding Back}" Padding="6">
                                    <Grid>
                                        <Border HorizontalAlignment="Left" Width="34" CornerRadius="2" Background="{Binding Panel}" />
                                        <Border HorizontalAlignment="Left" Margin="42 0 0 0" Width="40" Height="8" VerticalAlignment="Top" CornerRadius="2" Background="{Binding Accent}" />
                                        <Border HorizontalAlignment="Left" Margin="42 16 0 0" Width="70" Height="22" VerticalAlignment="Top" CornerRadius="2" Background="{Binding Panel}" />
                                    </Grid>
                                </Border>
                                <Grid Margin="0 8 0 0">
                                    <TextBlock Style="{StaticResource TextBlockBase}" FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock x:Name="InUse" Visibility="Collapsed" HorizontalAlignment="Right" FontSize="{fpx:FontPx 12}" Style="{StaticResource TextBlockBase}"
                                               Foreground="{DynamicResource AccentMidBrush}" Text="✓" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IslandHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentMidBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IslandSelectedBrush}" />
                                <Setter TargetName="InUse" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="840" HorizontalAlignment="Stretch" Margin="32 24 32 32">

                <TextBlock Style="{StaticResource SettingPageTitle}" Text="{DynamicResource settings_nav_theme}" />

                <!-- tema -->
                <Grid Margin="0 22 0 12">
                    <TextBlock Style="{StaticResource SettingSection}" Margin="0" VerticalAlignment="Center" Text="{DynamicResource Theme}" />
                    <Button HorizontalAlignment="Right" Height="32" Padding="14 0" Style="{StaticResource BtnSecondary}"
                            Content="{DynamicResource Reset}" Command="{Binding CmdResetTheme}" />
                </Grid>
                <ListBox ItemsSource="{Binding ThemeCards}" SelectedValue="{Binding ThemeName}" SelectedValuePath="Name"
                         Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource ThemeCardItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <!-- testo -->
                <TextBlock Style="{StaticResource SettingSection}" Text="{DynamicResource settings_font}" />
                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{DynamicResource settings_font_family}">
                    <ComboBox Width="300" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="420"
                              TextSearch.TextPath="Name" ItemsSource="{Binding FontOptions}"
                              SelectedValuePath="Name" SelectedValue="{Binding FontFamily}">
                        <!-- ogni nome e' scritto con il suo stesso carattere -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontFamily="{Binding Name}" FontSize="{fpx:FontPx 15}" Padding="2 3" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="{fpx:FontPx 12}" FontWeight="SemiBold" Margin="6 8 0 4" Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ComboBox.GroupStyle>
                    </ComboBox>
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{DynamicResource settings_font_size}">
                    <ListBox Style="{StaticResource SegmentedListBox}" ItemsSource="{Binding FontSizeOptions}" SelectedItem="{Binding FontSize}" DisplayMemberPath="Name" />
                </HeaderedContentControl>

                <!-- colori personalizzati: sezione avanzata -->
                <Expander Style="{StaticResource EditorAccordion}" Margin="0 28 0 0" Header="{DynamicResource Custom}">
                    <Grid Margin="4 8 0 8" Width="450" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"></RowDefinition>
                            <RowDefinition Height="40"></RowDefinition>
                            <RowDefinition Height="40"></RowDefinition>
                            <RowDefinition Height="40"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                            </Style>
                            <Style TargetType="{x:Type colorPickerWpf:ColorPickRowPopup}">
                                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                <Setter Property="HexVisible" Value="Collapsed"></Setter>
                            </Style>
                        </Grid.Resources>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Normal}"></TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource Lighter}"></TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource Darker}"></TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="{DynamicResource Font}"></TextBlock>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Color1}"></TextBlock>
                        <colorPickerWpf:ColorPickRowPopup Grid.Row="1" Grid.Column="1" HexColor="{Binding PrimaryMidColor}" />
                        <colorPickerWpf:ColorPickRowPopup Grid.Row="1" Grid.Column="2" HexColor="{Binding PrimaryLightColor}" />
                        <colorPickerWpf:ColorPickRowPopup Grid.Row="1" Grid.Column="3" HexColor="{Binding PrimaryDarkColor}" />
                        <colorPickerWpf:ColorPickRowPopup Grid.Row="1" Grid.Column="4" HexColor="{Binding PrimaryTextColor}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Color2}"></TextBlock>
                        <colorPickerWpf:ColorPickRowPopup Grid.Row="2" Grid.Column="1" HexColor="{Binding AccentMidColor}" />
                        <colorPickerWpf:ColorPickRowPopup Grid.Row="2" Grid.Column="2" HexColor="{Binding AccentLightColor}" />
                        <colorPickerWpf:ColorPickRowPopup Grid.Row="2" Grid.Column="3" HexColor="{Binding AccentDarkColor}" />
                        <colorPickerWpf:ColorPickRowPopup Grid.Row="2" Grid.Column="4" HexColor="{Binding AccentTextColor}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Background}"></TextBlock>
                        <colorPickerWpf:ColorPickRowPopup Grid.Row="3" Grid.Column="1" HexColor="{Binding BackgroundColor}" />
                        <colorPickerWpf:ColorPickRowPopup Grid.Row="3" Grid.Column="4" HexColor="{Binding BackgroundTextColor}" />
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
