<UserControl x:Class="Lemora.View.Settings.CredentialVault.CredentialVaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Lemora.View.Settings.CredentialVault"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:CredentialVaultViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="840" HorizontalAlignment="Stretch" Margin="32 24 32 32">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SettingPageTitle}" VerticalAlignment="Center" Text="{DynamicResource Credentials Vault}" />
                    <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Command="{Binding CmdAdd}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeometryCross}" Stretch="Uniform" Width="12" Height="12" Fill="{DynamicResource AccentTextBrush}" />
                            <TextBlock Text="{DynamicResource Add}" Margin="10 0 0 0" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Margin="0 10 0 0" TextWrapping="Wrap" Foreground="{DynamicResource IslandSecondaryTextBrush}" Text="{DynamicResource settings_vault_intro}" />

                <Border Margin="0 18 0 0" BorderThickness="1" BorderBrush="{DynamicResource IslandBorderBrush}" CornerRadius="{StaticResource IslandRadius}"
                        Background="{DynamicResource IslandSubCardBrush}" ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding Credentials}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14 10" BorderThickness="0 0 0 1" BorderBrush="{DynamicResource IslandDividerBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource TextBlockBase}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Credential.Name}" />
                                            <TextBlock Style="{StaticResource TextBlockBase}" FontSize="{fpx:FontPx 12}" Foreground="{DynamicResource IslandSecondaryTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding DataSource.DataSourceName}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Style="{StaticResource TextBlockBase}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Credential.UserName}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource TextBlockBase}" VerticalAlignment="Center" Foreground="{DynamicResource IslandSecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis" Text="{Binding Credential.PrivateKeyPath}" ToolTip="{Binding Credential.PrivateKeyPath}" />
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource IslandSecondaryTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                                    <Setter Property="Text" Value="••••••" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=Credential.Password}" Value="">
                                                            <Setter Property="Text" Value="" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Height="30" Padding="12 0" Margin="8 0 0 0" Content="{DynamicResource Edit}"
                                                    Command="{Binding Path=DataContext.CmdEdit, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=DataSource.IsWritable}" Value="False">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Height="30" Padding="12 0" Margin="8 0 0 0" Content="{DynamicResource Delete}"
                                                    Command="{Binding Path=DataContext.CmdDelete, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BtnDanger}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=DataSource.IsWritable}" Value="False">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
