<protocolHosts1:HostBase x:Class="Lemora.View.Host.ProtocolHosts.AxMsRdpClient09Host"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:protocolHosts1="clr-namespace:Lemora.View.Host.ProtocolHosts"
                  mc:Ignorable="d" 
                  d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="Grid">
        <WindowsFormsHost x:Name="RdpHost"/>
        <!-- ultima immagine dello schermo, tenuta ferma durante una riconnessione -->
        <Image x:Name="FrozenFrame" Stretch="Fill" Visibility="Collapsed" />
        <Control Name="GridLoading" Style="{StaticResource BusyAnimationStyle}" Background="{DynamicResource BackgroundBrush}"/>
        <Grid Name="GridMessageBox" Background="{DynamicResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.1*" MaxWidth="100" MinWidth="20"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="0.1*" MaxWidth="100" MinWidth="20"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Name="TbMessageTitle" FontSize="{fpx:FontPx 18}" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Title" Foreground="{DynamicResource PrimaryTextBrush}" Margin="10"></TextBlock>
                <TextBlock Name="TbMessage" FontSize="{fpx:FontPx 13.5}" HorizontalAlignment="Center" TextAlignment="Center" Text="" Foreground="{DynamicResource IslandSecondaryTextBrush}" Margin="5" TextWrapping="WrapWithOverflow" MaxWidth="560"></TextBlock>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 20 0 0">
                    <Button x:Name="BtnReconn" Click="BtnReconn_OnClick" Style="{StaticResource BtnPrimary}" MinWidth="96" Margin="5" Content="{DynamicResource Reconnect}"></Button>
                    <Button x:Name="BtnCreds" Click="BtnCreds_OnClick" Visibility="Collapsed" Style="{StaticResource BtnSecondary}" Height="34" MinWidth="96" Margin="5" Content="{DynamicResource host_change_credentials}"></Button>
                    <Button x:Name="BtnCancel" Click="BtnCancel_OnClick" Style="{StaticResource BtnSecondary}" Height="34" MinWidth="96" Margin="5" Content="{DynamicResource Dismiss}"></Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</protocolHosts1:HostBase>
