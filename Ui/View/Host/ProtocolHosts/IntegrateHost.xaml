<protocolHosts1:HostBase x:Class="Lemora.View.Host.ProtocolHosts.IntegrateHost"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:fpx="clr-namespace:Lemora.Utils"
                           xmlns:protocolHosts1="clr-namespace:Lemora.View.Host.ProtocolHosts"
                           mc:Ignorable="d" Background="Black"
                           d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="Black" Margin="0 1 0 0">
        <WindowsFormsHost x:Name="FormsHost" Background="{x:Null}"/>
        <!-- FreeRDP only: Lemora's loading screen and messages instead of the program's windows (FormsHost hidden meanwhile: it sits above everything) -->
        <Control Name="GridLoading" Style="{StaticResource BusyAnimationStyle}" Background="{DynamicResource BackgroundBrush}" Visibility="Collapsed"/>
        <Grid Name="GridMessageBox" Background="{DynamicResource BackgroundBrush}" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <TextBlock Name="TbMessage" FontSize="{fpx:FontPx 13.5}" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource IslandSecondaryTextBrush}" Margin="5" TextWrapping="WrapWithOverflow" MaxWidth="560"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20 0 0">
                    <Button x:Name="BtnReconn" Click="BtnReconn_OnClick" Style="{StaticResource BtnPrimary}" MinWidth="96" Margin="5" Content="{DynamicResource Reconnect}"/>
                    <Button x:Name="BtnCreds" Click="BtnCreds_OnClick" Style="{StaticResource BtnSecondary}" Height="34" MinWidth="96" Margin="5" Content="{DynamicResource host_change_credentials}"/>
                    <Button x:Name="BtnCancel" Click="BtnCancel_OnClick" Style="{StaticResource BtnSecondary}" Height="34" MinWidth="96" Margin="5" Content="{DynamicResource Dismiss}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</protocolHosts1:HostBase>
