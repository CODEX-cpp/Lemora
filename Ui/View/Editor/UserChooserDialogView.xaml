<styles:WindowChromeBase x:Class="Lemora.View.Editor.UserChooserDialogView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:styles="clr-namespace:Shawn.Utils.WpfResources.Theme.Styles;assembly=Shawn.Utils.WpfResources"
                         xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources"
                         xmlns:editor="clr-namespace:Lemora.View.Editor"
                         xmlns:controls="clr-namespace:Lemora.Controls"
                         ShowInTaskbar="False"
                         ResizeMode="NoResize"
                         WindowStyle="None"
                         SizeToContent="Height"
                         WindowStartupLocation="CenterOwner"
                         Background="Transparent"
                         mc:Ignorable="d"
                         d:DataContext="{d:DesignInstance editor:UserChooserDialogViewModel}"
                         Title="UserChooserDialogView" Width="460">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>
    <!-- scelta utente (blueprint §12): cornice comune; ogni utente e' un pulsante di larghezza piena -->
    <controls:DialogFrame Margin="40" Title="{Binding Title}" CanDragWindow="True" CloseCommand="{Binding CmdQuit}">
        <StackPanel Margin="24 20 24 12">
            <TextBlock Style="{StaticResource TextBlockBase}" Margin="0 0 0 14" TextWrapping="Wrap" Foreground="{DynamicResource IslandSecondaryTextBrush}"
                       Text="{DynamicResource user_chooser_text}" />
            <ItemsControl ItemsSource="{Binding Users}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource BtnSecondary}" Height="42" Margin="0 0 0 8" HorizontalContentAlignment="Left" Padding="14 0"
                                Command="{Binding DataContext.CmdChoose, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" Content="{Binding Display}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </controls:DialogFrame>
</styles:WindowChromeBase>
