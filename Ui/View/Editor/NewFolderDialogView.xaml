<styles:WindowChromeBase x:Class="Lemora.View.Editor.NewFolderDialogView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:styles="clr-namespace:Shawn.Utils.WpfResources.Theme.Styles;assembly=Shawn.Utils.WpfResources"
                         xmlns:editor="clr-namespace:Lemora.View.Editor"
                         xmlns:ctl="clr-namespace:Lemora.Controls"
                         ShowInTaskbar="False"
                         ResizeMode="NoResize"
                         WindowStyle="None"
                         SizeToContent="Height"
                         WindowStartupLocation="CenterOwner"
                         Background="Transparent"
                         mc:Ignorable="d"
                         d:DataContext="{d:DesignInstance editor:NewFolderDialogViewModel}"
                         Title="NewFolderDialogView" Width="560">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
            <Setter Property="Foreground" Value="{DynamicResource IslandSecondaryTextBrush}" />
            <Setter Property="Width" Value="110" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
            <Setter Property="FontSize" Value="{fpx:FontPx 12}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentMidBrush}" />
            <Setter Property="Margin" Value="0 18 0 12" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
            <Setter Property="FontSize" Value="{fpx:FontPx 12}" />
            <Setter Property="Foreground" Value="{DynamicResource IslandSecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="110 8 0 0" />
        </Style>
    </Window.Resources>

    <!-- nuova cartella (blueprint §12, F1): Nome, Dentro a, DOMINIO, RETE; Annulla / Crea cartella -->
    <ctl:DialogFrame Margin="40" Title="{DynamicResource folder_new_title}" CanDragWindow="True" CloseCommand="{Binding CmdQuit}">
        <ctl:DialogFrame.Footer>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BtnSecondary}" MinWidth="90" Command="{Binding CmdQuit}" Content="{DynamicResource Cancel}" />
                <Button Style="{StaticResource BtnPrimary}" MinWidth="130" Margin="10 0 0 0" Command="{Binding CmdCreate}" Content="{DynamicResource folder_create}" />
            </StackPanel>
        </ctl:DialogFrame.Footer>
        <StackPanel Margin="28 24 28 12">
            <Grid Margin="0 0 0 14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Name}" />
                <TextBox Name="TbName" Grid.Column="1" Height="36" VerticalContentAlignment="Center" Padding="8 0"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Foreground="#FF9B94" Margin="110 -6 0 10" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource ConverterEqual2Collapsed}, ConverterParameter=''}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource folder_parent}" />
                <ComboBox Grid.Column="1" Height="36" ItemsSource="{Binding ParentChoices}" DisplayMemberPath="Display"
                          SelectedValuePath="Path" SelectedValue="{Binding Parent}" />
            </Grid>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource folder_section_domain}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource folder_domain}" />
                <TextBox Grid.Column="1" Width="260" Height="36" VerticalContentAlignment="Center" Padding="8 0" Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource folder_domain_hint}" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource folder_section_network}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource folder_section_network_label}" />
                <TextBox Grid.Column="1" Width="260" Height="36" VerticalContentAlignment="Center" Padding="8 0" FontFamily="Cascadia Mono, Consolas"
                         Tag="{Binding SuggestedIpPrefix}" Text="{Binding IpPrefix, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource folder_network_hint_short}" />
        </StackPanel>
    </ctl:DialogFrame>
</styles:WindowChromeBase>
