<styles:WindowChromeBase x:Class="Lemora.View.Editor.PasswordPopupDialogView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:styles="clr-namespace:Shawn.Utils.WpfResources.Theme.Styles;assembly=Shawn.Utils.WpfResources"
                         xmlns:editor="clr-namespace:Lemora.View.Editor"
                         xmlns:controls="clr-namespace:Lemora.Controls"
                         ShowInTaskbar="False"
                         ResizeMode="NoResize"
                         WindowStyle="None"
                         SizeToContent="Height"
                         WindowStartupLocation="CenterOwner"
                         Background="Transparent"
                         d:DesignHeight="400"
                         mc:Ignorable="d"
                         d:DataContext="{d:DesignInstance editor:PasswordPopupDialogViewModel}"
                         Title="PasswordPopupDialogView" Width="520">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
            <Setter Property="Foreground" Value="{DynamicResource IslandSecondaryTextBrush}"></Setter>
            <Setter Property="Width" Value="90"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
    </Window.Resources>

    <!-- richiesta credenziali (blueprint §12, D3): destinazione in monospazio accent, Utente / Password, "ricorda", Annulla + OK nel piè -->
    <controls:DialogFrame Margin="40" Title="{DynamicResource Credentials}" CanDragWindow="True" CloseCommand="{Binding CmdQuit}">
        <controls:DialogFrame.Footer>
            <StackPanel Orientation="Horizontal">
                <Button Name="BtnQuit" MinWidth="90" Style="{StaticResource BtnSecondary}" Content="{DynamicResource Cancel}" Command="{Binding CmdQuit}" />
                <Button Name="BtnSave" MinWidth="90" Margin="10 0 0 0" Style="{StaticResource BtnPrimary}" Content="{DynamicResource OK}" Command="{Binding CmdSave}" />
            </StackPanel>
        </controls:DialogFrame.Footer>
        <StackPanel Margin="24 22 24 22">
            <TextBlock Text="{Binding Title}" FontFamily="Cascadia Mono, Consolas" FontSize="{fpx:FontPx 13}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0 0 0 18"
                       Style="{StaticResource TextBlockBase}" Foreground="{DynamicResource AccentMidBrush}" />

            <Grid Margin="0 0 0 14" Visibility="{Binding IsUserNameVisible, Converter={StaticResource ConverterBool2Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource User}" />
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- dominio della cartella: chip a sinistra (come il prefisso IP del nome host), si puo' togliere -->
                    <Border Height="36" Padding="10 0 4 0" Background="{DynamicResource PrimaryDarkBrush}" BorderThickness="1 1 0 1" BorderBrush="{DynamicResource IslandButtonBorderBrush}"
                            CornerRadius="4 0 0 4" Visibility="{Binding HasDomain, Converter={StaticResource ConverterBool2Visible}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource AccentMidBrush}" VerticalAlignment="Center" Text="{Binding DomainChip}" />
                            <Button Margin="6 0 0 0" Width="22" Height="22" Padding="0" Style="{x:Null}" Cursor="Hand" Focusable="False" Background="Transparent" BorderThickness="0"
                                    Command="{Binding CmdRemoveDomain}" ToolTip="{DynamicResource domain_chip_remove}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                                            <TextBlock Text="&#x2715;" FontSize="{fpx:FontPx 11}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IslandHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBox Name="TbUserName" Grid.Column="1" MinHeight="36" VerticalContentAlignment="Center" Padding="8 0"
                             Text="{Binding UserNameInput, UpdateSourceTrigger=PropertyChanged}" KeyDown="TbUserName_OnKeyDown" />
                </Grid>
            </Grid>

            <Grid Margin="0 0 0 14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Password}" />
                <!-- password rifiutata: contorno rosso e testo sotto -->
                <Border Grid.Column="1" BorderThickness="1" CornerRadius="4" Visibility="{Binding UsePrivateKeyForConnect, Converter={StaticResource ConverterBool2VisibleInv}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="BorderBrush" Value="#F28B82" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <controls:PasswordInput x:Name="TbPwd" Height="34"
                                            KeyDown="TbPwd_OnKeyDown"
                                            Password="{Binding Password, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }" />
                </Border>
                <Grid Grid.Column="1" Visibility="{Binding UsePrivateKeyForConnect, Converter={StaticResource ConverterBool2Visible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Name="TbPrivateKey" Text="{Binding PrivateKey}" MinHeight="36" VerticalContentAlignment="Center" Padding="8 0" />
                    <Button Grid.Column="1" Margin="8 0 0 0" Content="{DynamicResource Select}" Click="ButtonOpenPrivateKey_OnClick" Style="{StaticResource BtnSecondary}" />
                </Grid>
            </Grid>

            <TextBlock Margin="90 -8 0 10" FontSize="{fpx:FontPx 12}" Foreground="#F28B82" Text="{Binding ErrorText}" Style="{StaticResource TextBlockBase}"
                       Visibility="{Binding HasError, Converter={StaticResource ConverterBool2Visible}}" />

            <CheckBox Name="CbUsePrivateKeyForConnect" Margin="90 0 0 10"
                      Visibility="{Binding CanUsePrivateKeyForConnect, Converter={StaticResource ConverterBool2Visible}}"
                      IsChecked="{Binding UsePrivateKeyForConnect}"
                      Content="{DynamicResource 'Use private key'}" />

            <CheckBox Name="CbRememberMe" Margin="90 0 0 0"
                      Visibility="{Binding CanRememberInfo, Converter={StaticResource ConverterBool2Visible}}"
                      IsChecked="{Binding IsRememberInfo}"
                      Content="{DynamicResource 'Remember the information above'}" />

            <!-- utenti delle credenziali condivise della cartella: un clic li usa e collega -->
            <StackPanel Margin="0 18 0 0" Visibility="{Binding HasSuggestions, Converter={StaticResource ConverterBool2Visible}}">
                <TextBlock Text="{Binding SuggestionsTitle}" FontSize="{fpx:FontPx 11}" FontWeight="SemiBold" Margin="0 0 0 8"
                           Foreground="{DynamicResource AccentMidBrush}" Style="{StaticResource TextBlockBase}" />
                <ItemsControl ItemsSource="{Binding SuggestedUsers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0 0 0 6" Height="36" Padding="12 0" HorizontalContentAlignment="Stretch" Style="{StaticResource BtnSecondary}"
                                    Command="{Binding DataContext.CmdUseSuggested, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource use_and_connect}" VerticalAlignment="Center" Margin="16 0 0 0"
                                               Foreground="{DynamicResource IslandSecondaryTextBrush}" FontSize="{fpx:FontPx 12}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </controls:DialogFrame>
</styles:WindowChromeBase>
