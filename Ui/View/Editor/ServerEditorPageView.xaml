                <Border Grid.Column="4" Style="{StaticResource IslandBorder}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24 22">
                            <TextBlock Style="{StaticResource EditorSectionTitle}" Text="{DynamicResource editor_summary}" />
                            <Grid Margin="0 18 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" Background="{DynamicResource PrimaryDarkBrush}" BorderThickness="1"
                                        BorderBrush="{DynamicResource IslandBorderBrush}" CornerRadius="{StaticResource IslandRadius}">
                                    <TextBlock Style="{StaticResource EditorSigla}" Text="{Binding ProtocolDisplayName}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" DataContext="{Binding SelectedProtocol}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14 0 0 0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource TextBlockBase}" FontSize="{fpx:FontPx 20}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Server.DisplayName}" />
                                    <TextBlock Style="{StaticResource TextBlockBase}" Foreground="{DynamicResource IslandSecondaryTextBrush}"
                                               Text="{Binding SelectedProtocol.Protocol, Converter={StaticResource ProtocolDescriptionConverter}}" />
                                </StackPanel>
                            </Grid>
                            <Border Margin="0 18 0 0" Background="{DynamicResource PrimaryDarkBrush}" BorderThickness="1"
                                    BorderBrush="{DynamicResource IslandBorderBrush}" CornerRadius="{StaticResource IslandRadius}">
                                <Grid Margin="16 12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource TextBlockBase}" Foreground="{DynamicResource IslandSecondaryTextBrush}" Text="{DynamicResource Target}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextBlockBase}" TextWrapping="Wrap" Text="{Binding Server.SubTitle}" />
                                </Grid>
                            </Border>
                            <Border Margin="0 8 0 0" Background="{DynamicResource PrimaryDarkBrush}" BorderThickness="1"
                                    BorderBrush="{DynamicResource IslandBorderBrush}" CornerRadius="{StaticResource IslandRadius}"
                                    Visibility="{Binding IsBuckEdit, Converter={StaticResource ConverterBool2VisibleInv}}">
                                <StackPanel Margin="16 12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource TextBlockBase}" Foreground="{DynamicResource IslandSecondaryTextBrush}" Text="{DynamicResource editor_folder}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource TextBlockBase}" TextWrapping="Wrap" Text="{Binding SelectedFolder}" />
                                    </Grid>
                                    <Grid Margin="0 10 0 0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource TextBlockBase}" Foreground="{DynamicResource IslandSecondaryTextBrush}" Text="{DynamicResource editor_favorite}" />
                                        <Path Grid.Column="1" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left"
                                              Data="M 8,1 L 10.2,5.8 L 15.4,6.4 L 11.5,9.9 L 12.6,15 L 8,12.4 L 3.4,15 L 4.5,9.9 L 0.6,6.4 L 5.8,5.8 Z"
                                              StrokeThickness="1.4" StrokeLineJoin="Round" Stroke="{DynamicResource AccentMidBrush}">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource AccentMidBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Margin="0 8 0 0" Background="{DynamicResource PrimaryDarkBrush}" BorderThickness="1"
                                    BorderBrush="{DynamicResource IslandBorderBrush}" CornerRadius="{StaticResource IslandRadius}">
                                <StackPanel Margin="16 12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource TextBlockBase}" Foreground="{DynamicResource IslandSecondaryTextBrush}" Text="{DynamicResource editor_summary_access}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource TextBlockBase}" TextWrapping="Wrap" Text="{Binding SummaryAccess}" />
                                    </Grid>
                                    <Grid Margin="0 10 0 0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource TextBlockBase}" Foreground="{DynamicResource IslandSecondaryTextBrush}" Text="{DynamicResource editor_summary_advanced}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource TextBlockBase}" Foreground="{DynamicResource AccentMidBrush}" Text="{Binding SummaryAdvanced}" />
