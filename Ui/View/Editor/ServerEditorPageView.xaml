                            <Button Style="{StaticResource BtnSecondary}" Margin="0 24 0 0" HorizontalAlignment="Stretch"
                                    Command="{Binding CmdResetDefaults}" Content="{DynamicResource editor_reset}"
                                    Visibility="{Binding IsBuckEdit, Converter={StaticResource ConverterBool2VisibleInv}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- barra di stato: cosa manca per salvare -->
            <TextBlock Grid.Row="2" Margin="8 6 0 0" Style="{StaticResource TextBlockBase}"
                       Foreground="{DynamicResource IslandSecondaryTextBrush}" FontSize="{DynamicResource GlobalFontSizeSmall}"
                       Text="{Binding MissingFieldsText}" />
        </Grid>


        <!-- messaggio a comparsa (cartella ⇄ dominio e prefisso IP), con Annulla -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0 0 0 48" MaxWidth="760"
                Background="#2B2B2B" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="4"
                Visibility="{Binding IsToastVisible, Converter={StaticResource ConverterBool2Visible}}">
            <Grid>
                <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource AccentMidBrush}" CornerRadius="4 0 0 4" />
                <StackPanel Orientation="Horizontal" Margin="18 10 10 10">
                    <TextBlock Style="{StaticResource TextBlockBase}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="470" FontSize="{fpx:FontPx 13.5}" Text="{Binding ToastText}" />
                    <Button Style="{StaticResource BtnPrimary}" Margin="16 0 0 0" Padding="14 0" MinHeight="30" Command="{Binding CmdToastAction}" Content="{Binding ToastActionText}"
                            Visibility="{Binding HasToastAction, Converter={StaticResource ConverterBool2Visible}}" />
                    <Button Style="{StaticResource BtnSecondary}" Margin="8 0 0 0" Padding="14 0" MinHeight="30" Command="{Binding CmdToastCancel}" Content="{DynamicResource Cancel}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- bulk editing flag-->
        <StackPanel Width="400" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    ToolTip="{Binding Title}"
                    RenderTransformOrigin="0.5,0.5" 
                    Margin="0,35,-130,0" Background="{DynamicResource AccentMidBrush}">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"></Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Title}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProtocolList.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"></Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="42.671"/>
                    <TranslateTransform X="15.43885806483096" Y="16.392014547605541"/>
                </TransformGroup>
            </StackPanel.RenderTransform>
            <StackPanel.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" Direction="0" ShadowDepth="2" Opacity="0.7" RenderingBias="Performance">
                </DropShadowEffect>
            </StackPanel.Effect>
            <TextBlock Style="{StaticResource TextBlockBase}" Name="TbServerType" Opacity="0.9"
                       FontWeight="Bold" Text="{DynamicResource server_editor_bulk_editing}" 
                       Margin="0 5"
                       Width="100"
                       TextAlignment="Center"
                       Foreground="{DynamicResource AccentTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.FontSize>
                    <MultiBinding Converter="{StaticResource ConverterTextWidthAndContent2PresentationSize}" ConverterParameter="FontSize">
                        <Binding RelativeSource="{RelativeSource Self}" Path="Text"></Binding>
                        <Binding RelativeSource="{RelativeSource Self}" Path="Width"></Binding>
                        <Binding RelativeSource="{RelativeSource Self}" Path="FontFamily"></Binding>
                        <Binding RelativeSource="{RelativeSource Self}" Path="FontStyle"></Binding>
                        <Binding RelativeSource="{RelativeSource Self}" Path="FontWeight"></Binding>
                        <Binding RelativeSource="{RelativeSource Self}" Path="FontStretch"></Binding>
                    </MultiBinding>
                </TextBlock.FontSize>
            </TextBlock>
        </StackPanel>


    </Grid>
</UserControl>