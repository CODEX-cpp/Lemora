<UserControl x:Class="Lemora.View.Editor.ServerEditorPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:Lemora.Controls"
             xmlns:icons="clr-namespace:Lemora.Resources.Icons"
             xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources"
             xmlns:colorPickerWpf="clr-namespace:ColorPickerWPF;assembly=Shawn.Utils.Wpf"
             xmlns:controls1="clr-namespace:Shawn.Utils.Wpf.Controls;assembly=Shawn.Utils.Wpf"
             xmlns:editor="clr-namespace:Lemora.View.Editor"
             xmlns:noteDisplay="clr-namespace:Lemora.Controls.NoteDisplay"
             xmlns:dao="clr-namespace:Lemora.Service.DataSource.DAO"
             xmlns:s="https://github.com/canton7/Stylet"
             xmlns:controls2="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance editor:ServerEditorPageViewModel}"
             Background="White"
             d:DesignHeight="1000" d:DesignWidth="800">

    <Grid Background="{DynamicResource PrimaryDarkBrush}" ClipToBounds="True">
        <Grid.Resources>
            <editor:ProtocolGroupConverter x:Key="ProtocolGroupConverter" />
            <editor:ProtocolDescriptionConverter x:Key="ProtocolDescriptionConverter" />
            <editor:ProtocolTextConverter x:Key="ProtocolTextConverter" />
            <editor:RunnerNameConverter x:Key="RunnerNameConverter" />
            <system:Double x:Key="DefaultControlHeight">36</system:Double>
            <editor:RunnerDisplayConverter x:Key="RunnerDisplayConverter" />
            <!-- nessun riquadro rosso: solo dopo un salvataggio mancato i campi obbligatori vuoti prendono un bordo ambra -->
            <ControlTemplate x:Key="EditorErrorTemplate">
                <Grid>
                    <AdornedElementPlaceholder />
                    <Border IsHitTestVisible="False" BorderThickness="1.5" BorderBrush="#F2A33A" CornerRadius="{StaticResource IslandRadius}"
                            Visibility="{Binding Source={x:Static editor:EditorUiState.Instance}, Path=Highlight, Converter={StaticResource ConverterBool2Visible}}" />
                </Grid>
            </ControlTemplate>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Validation.ErrorTemplate" Value="{StaticResource EditorErrorTemplate}" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
            <CollectionViewSource x:Key="ProtocolsView" Source="{Binding ProtocolList}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Protocol" Converter="{StaticResource ProtocolGroupConverter}" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
            <Style x:Key="EditorSigla" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource ProtocolOtherBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Protocol}" Value="RDP"><Setter Property="Foreground" Value="{DynamicResource ProtocolRdpBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Protocol}" Value="RemoteApp"><Setter Property="Foreground" Value="{DynamicResource ProtocolRdpBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Protocol}" Value="SSH"><Setter Property="Foreground" Value="{DynamicResource ProtocolSshBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Protocol}" Value="VNC"><Setter Property="Foreground" Value="{DynamicResource ProtocolVncBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Protocol}" Value="SFTP"><Setter Property="Foreground" Value="{DynamicResource ProtocolSftpBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Protocol}" Value="FTP"><Setter Property="Foreground" Value="{DynamicResource ProtocolSftpBrush}" /></DataTrigger>
                        </Style.Triggers>
            </Style>
            <Style x:Key="EditorSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                <Setter Property="Foreground" Value="{DynamicResource AccentMidBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="{DynamicResource GlobalFontSizeSmall}" />
            </Style>
        </Grid.Resources>

        <Grid Margin="6 0 6 6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- barra strumenti: titolo, protocollo, Annulla / Salva -->
            <Border Grid.Row="0" Margin="0 0 0 6" Padding="16 0" Height="64"
                    Background="{DynamicResource PrimaryMidBrush}"
                    BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource IslandRadius}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="{fpx:FontPx 16}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                    <Setter Property="Text" Value="{DynamicResource Edit}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddMode}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource editor_title_new}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBuckEdit}" Value="True">
                                            <Setter Property="Text" Value="{Binding Title}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource TextBlockBase}" FontSize="{DynamicResource GlobalFontSizeSmall}"
                                   Foreground="{DynamicResource IslandSecondaryTextBrush}"
                                   Text="{Binding Subtitle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnSecondary}" Margin="0 0 10 0" MinWidth="90"
                                Command="{Binding CmdCancel}" Content="{DynamicResource Cancel}" />
                        <Button Name="ButtonSave" MinWidth="110" Command="{Binding CmdSave}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReadyToSave}" Value="False">
                                            <Setter Property="Background" Value="#3A3A3A" />
                                            <Setter Property="Foreground" Value="#9A9A9A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Border Height="16" Width="16" CornerRadius="2" Margin="0 0 6 0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Server.DataSource.Status}" Value="{x:Static dao:EnumDatabaseStatus.OK}">
                                                    <Setter Property="Visibility" Value="Collapsed"></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Path Fill="Red" Height="14" Width="14" UseLayoutRounding="True" Stretch="Uniform" Data="{StaticResource GeometryCloudDisconnected}"/>
                                </Border>
                                <TextBlock Style="{StaticResource TextBlockBase}" Text="{DynamicResource Save}" Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}"></TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- corpo: protocolli | form | riepilogo -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="180" MaxWidth="360" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="260" MinWidth="220" MaxWidth="460" />
                </Grid.ColumnDefinitions>

                <!-- isola protocolli (nascosta nella modifica multipla) -->
                <Border Grid.Column="0" Style="{StaticResource IslandBorder}"
                        Visibility="{Binding IsBuckEdit, Converter={StaticResource ConverterBool2VisibleInv}}">
                    <ListBox Name="ListBoxProtocols"
                             ItemsSource="{Binding Source={StaticResource ProtocolsView}}"
                             SelectedValue="{Binding SelectedProtocol}"
                             Background="Transparent" BorderThickness="0" Padding="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource EditorSectionTitle}" Text="{Binding Name}" Margin="12 16 0 6" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid Height="46">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource IslandRadius}" />
                                                <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0 8" CornerRadius="2"
                                                        Background="{DynamicResource AccentMidBrush}" Visibility="Collapsed" />
                                                <ContentPresenter Margin="16 0 8 0" VerticalAlignment="Center" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IslandHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IslandSelectedBrush}" />
                                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource EditorSigla}" Text="{Binding ProtocolDisplayName}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextBlockBase}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource IslandSecondaryTextBrush}" VerticalAlignment="Center"
                                               Text="{Binding Protocol, Converter={StaticResource ProtocolDescriptionConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ShowsPreview="False" ResizeBehavior="PreviousAndNext"
                              Visibility="{Binding IsBuckEdit, Converter={StaticResource ConverterBool2VisibleInv}}" />
                <!-- isola form (il contenuto di prima) -->
                <Border Grid.Column="2" Style="{StaticResource IslandBorder}">
        <Grid>
            <Grid.Resources>
                <Style TargetType="TextBlock" x:Key="RowHeader" BasedOn="{StaticResource TextBlockBase}">
                    <Setter Property="Foreground" Value="{DynamicResource BackgroundTextBrush}"></Setter>
                    <Setter Property="Width" Value="130"></Setter>
                    <Setter Property="VerticalAlignment" Value="Center"></Setter>
                    <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                    <Setter Property="TextAlignment" Value="Left"></Setter>
                    <Setter Property="TextWrapping" Value="WrapWithOverflow"></Setter>
                    <Setter Property="Margin">
                        <Setter.Value>
                            <Thickness Right="16"></Thickness>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!-- stessa altezza (36) per tutti i campi di tutti i form -->
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Setter Property="Height" Value="36"></Setter>
                    <Setter Property="MinHeight" Value="36"></Setter>
                </Style>
                <Style TargetType="controls:GridWith4Columns">
                    <Setter Property="Height" Value="Auto"></Setter>
                    <Setter Property="MinHeight" Value="30"></Setter>
                    <Setter Property="Margin">
                        <Setter.Value>
                            <Thickness Bottom="0" Top="15"></Thickness>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <ScrollViewer Grid.IsSharedSizeScope="True"
                          x:Name="ScrollViewerMain" SizeChanged="ScrollViewerMain_OnSizeChanged"
                          PreviewMouseWheel="ScrollViewerMain_OnPreviewMouseWheel"
                          Margin="0 3 0 4"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid x:Name="FormGrid" UseLayoutRounding="True" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="28 28 28 32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="PanelLeft" Orientation="Vertical" Width="800" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource EditorGroupTextBlockTitle}" Text="{DynamicResource editor_section_identity}"></TextBlock>


                        <Grid>
                            <StackPanel Orientation="Vertical">
                                <controls:GridWith4Columns>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Name}" Style="{StaticResource RowHeader}"></TextBlock>
                                    <TextBox Grid.Column="1" Tag="{DynamicResource editor_name_placeholder}"
                                             Text="{Binding Server.DisplayName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True, ValidatesOnExceptions=True, ValidatesOnNotifyDataErrors=True}" />
                                </controls:GridWith4Columns>


                                <controls:GridWith4Columns Visibility="{Binding IsBuckEdit, Converter={StaticResource ConverterBool2VisibleInv}}">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource editor_folder}" Style="{StaticResource RowHeader}"></TextBlock>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding FolderChoices, Mode=OneWay}" DisplayMemberPath="Display" SelectedValuePath="Path" SelectedValue="{Binding SelectedFolder, Mode=TwoWay}" />
                                </controls:GridWith4Columns>

                                <!-- Salva in: Locale / Teams (cloud), solo per una voce nuova con il permesso di scrittura su Teams -->
                                <controls:GridWith4Columns Visibility="{Binding ShowSaveTarget, Converter={StaticResource ConverterBool2Visible}}">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource editor_save_to}" Style="{StaticResource RowHeader}"></TextBlock>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding SaveTargetIndex, Mode=TwoWay}" AutomationProperties.AutomationId="EditorSaveTarget">
                                        <ComboBoxItem Content="{DynamicResource editor_save_local}" />
                                        <ComboBoxItem>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0 1 6 0" VerticalAlignment="Center" Foreground="{DynamicResource AccentMidBrush}" />
                                                <TextBlock Text="{DynamicResource editor_save_teams}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                    </ComboBox>
                                </controls:GridWith4Columns>

                                <!-- permesso richieste con "Condividi le mie connessioni" spento nelle impostazioni: si sceglie qui, voce per voce (acceso in partenza) -->
                                <controls:GridWith4Columns Visibility="{Binding ShowSendRequest, Converter={StaticResource ConverterBool2Visible}}">
                                    <TextBlock Grid.Column="0" Text="Teams" Style="{StaticResource RowHeader}"></TextBlock>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding SendRequest, Mode=TwoWay}" Content="{DynamicResource editor_send_request}"
                                              AutomationProperties.AutomationId="EditorSendRequest" />
                                </controls:GridWith4Columns>

                                <controls:GridWith4Columns Visibility="{Binding IsBuckEdit, Converter={StaticResource ConverterBool2VisibleInv}}">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource editor_favorite}" Style="{StaticResource RowHeader}"></TextBlock>
                                    <ToggleButton Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource BtnFavorite}"
                                                  IsChecked="{Binding IsFavorite, Mode=TwoWay}">
                                        <Grid>
                                            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                       Text="{DynamicResource editor_favorite_add}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource TextBlockBase}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                       Text="{DynamicResource editor_favorite_on}"
                                                       Visibility="{Binding IsFavorite, Converter={StaticResource ConverterBool2Visible}}" />
                                        </Grid>
                                    </ToggleButton>
                                </controls:GridWith4Columns>

                                                    <controls:GridWith4Columns VerticalAlignment="Top">
    <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0 7 0 0">
        <TextBlock Text="{DynamicResource Note}" Style="{StaticResource RowHeader}" VerticalAlignment="Top"></TextBlock>
        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                                                <!--icon button show note-->
                                                <Button Name="ButtonShowNote"
                                                        Width="16" Height="16"
                                                        Background="Transparent"
                                                        attachProperty:VisionElement.BackgroundAccent="Transparent"
                                                        attachProperty:VisionElement.BackgroundOnMouseDown="Transparent"
                                                        Foreground="{DynamicResource BackgroundTextBrush}"
                                                        attachProperty:VisionElement.ForegroundAccent="{DynamicResource BackgroundTextBrush}"
                                                        attachProperty:VisionElement.ForegroundOnMouseDown="{DynamicResource BackgroundTextBrush}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Opacity="0.7"
                                                        ToolTip="{DynamicResource Preview}"
                                                        attachProperty:VisionElement.Opacity="0.8"
                                                        attachProperty:VisionElement.OpacityAccent="0.9"
                                                        MouseEnter="ButtonShowNote_OnMouseEnter"
                                                        Style="{StaticResource ButtonBarPrimaryStyle}"
                                                        Visibility="{Binding Server.Note, Converter={StaticResource ConverterNoteToVisibility}}"
                                                        >
                                                    <Path Data="{StaticResource NoteGeometry}"
                                                          Width="13"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                                                          StrokeThickness="0" Stretch="Uniform" />
                                                </Button>

                                                <Popup Name="PopupNote" 
                                                       AllowsTransparency="True"
                                                       PlacementTarget="{Binding ElementName=ButtonShowNote}" StaysOpen="False">
                                                    <noteDisplay:NoteDisplayAndEditor x:Name="PopupNoteGrid" Width="400" Height="300"
                                                                                      Server="{Binding Server, Mode=OneWay}"
                                                                                      EditEnable="False"
                                                                                      EditButtonVisibility="Collapsed"
                                                                                      CloseButtonVisibility="Collapsed"/>
                                                </Popup>
                                            </StackPanel>
    </StackPanel>
    <TextBox Grid.Column="1" TextWrapping="Wrap" Width="Auto"
                                                     TextAlignment="Left" Height="76" Margin="0"
                                                     MouseWheel="TextBoxMarkdown_OnMouseWheel"
                                                     VerticalContentAlignment="Top"
                                                     AcceptsReturn="True"
                                                     AcceptsTab="True"
                                                     Tag="&#13;# Markdown support&#13;&#13;- write your note here&#13;- foo&#13;&#13;![pic](http://x/structure.png)&#13;&#13;[link](http://x/readme.md)" xml:space="preserve"
                                                     Text="{Binding Server.Note, UpdateSourceTrigger=PropertyChanged}"></TextBox>
</controls:GridWith4Columns>

                                                                <controls:GridWith4Columns>
                                    <controls:GridWith4Columns.Style>
                                        <Style TargetType="controls:GridWith4Columns" BasedOn="{StaticResource {x:Type controls:GridWith4Columns}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Runners.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Runners.Count}" Value="1">
                                                    <Setter Property="Visibility" Value="Collapsed"></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:GridWith4Columns.Style>
                                    <TextBlock Style="{StaticResource RowHeader}" Grid.Column="0" Text="{DynamicResource editor_client}"></TextBlock>

                                    <StackPanel Grid.Column="1">
                                        <ListBox ItemsSource="{Binding Runners}"
                                                 SelectedItem="{Binding Server.SelectedRunnerName, Mode=TwoWay, Converter={StaticResource RunnerNameConverter}}"
                                                 Background="Transparent" BorderThickness="0" Padding="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="Margin" Value="0 0 6 6" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd" Padding="14 8" Background="Transparent" BorderThickness="1"
                                                                        BorderBrush="{DynamicResource IslandBorderBrush}" CornerRadius="{StaticResource IslandRadius}">
                                                                    <ContentPresenter TextElement.Foreground="{DynamicResource PrimaryTextBrush}" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IslandHoverBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IslandSelectedBrush}" />
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentMidBrush}" />
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentMidBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{StaticResource TextBlockBase}" Text="{Binding Converter={StaticResource RunnerDisplayConverter}}" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border Margin="0 6 0 0" Padding="14 10" Background="{DynamicResource PrimaryDarkBrush}" BorderThickness="1"
                                                BorderBrush="{DynamicResource IslandBorderBrush}" CornerRadius="{StaticResource IslandRadius}"
                                                Visibility="{Binding SelectedProtocol.Protocol, Converter={StaticResource ConverterEqual2Visible}, ConverterParameter=VNC}">
                                            <TextBlock Style="{StaticResource TextBlockBase}" TextWrapping="Wrap" Foreground="{DynamicResource IslandSecondaryTextBrush}"
                                                       Text="{DynamicResource editor_vnc_note}" />
                                        </Border>
                                    </StackPanel>
                                </controls:GridWith4Columns>

                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="PanelRight" Grid.Row="1" Orientation="Vertical" Width="800" VerticalAlignment="Top">
                                <ContentControl s:View.Model="{Binding EditorViewModel}"></ContentControl>
<Expander Style="{StaticResource EditorAccordion}" Header="{DynamicResource editor_section_session}" editor:AccordionHelper.Properties="AlwaysOpenInNewTabWindow,DoNotSync,CommandBeforeConnected,HideCommandBeforeConnectedWindow,CommandAfterDisconnected">
<StackPanel>
<controls:GridWith4Columns>
                                    <CheckBox IsChecked="{Binding Server.AlwaysOpenInNewTabWindow}" Grid.Column="1" Content="{DynamicResource 'Always open in new window'}"></CheckBox>
                                </controls:GridWith4Columns>
<controls:GridWith4Columns>
                                    <CheckBox IsChecked="{Binding Server.DoNotSync}" Grid.Column="1" Content="{Binding DoNotSyncLabel}" ToolTip="{Binding DoNotSyncHint}"></CheckBox>
                                </controls:GridWith4Columns>
<controls:GridWith4Columns>
                                    <TextBlock Style="{StaticResource RowHeader}" Grid.Column="0" Text="{DynamicResource 'Script before connect'}"></TextBlock>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Server.CommandBeforeConnected, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                             ToolTip="{DynamicResource 'Run bat before connect'}"
                                             Tag="{DynamicResource 'Run bat before connect'}"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Margin="5 0 0 0" 
                                                VerticalAlignment="Stretch"
                                                Command="{Binding CmdSelectScript}" CommandParameter="before"
                                                Style="{StaticResource ButtonPrimaryStyle}" 
                                                Content="{DynamicResource Select}"></Button>

                                        <Button Margin="5 0 0 0" 
                                                VerticalAlignment="Stretch"
                                                Command="{Binding CmdTestScript}" CommandParameter="before"
                                                Style="{StaticResource ButtonPrimaryStyle}" 
                                                Content="{DynamicResource Test}"></Button>
                                    </StackPanel>
                                </controls:GridWith4Columns>

                                <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                    <TextBlock Text="" Style="{StaticResource RowHeader}"></TextBlock>
                                    <CheckBox VerticalContentAlignment="Top"
                                              MaxWidth="440"
                                              IsChecked="{Binding Server.HideCommandBeforeConnectedWindow}" 
                                              ToolTip="{DynamicResource 'Hide script window'}">
                                        <TextBlock Text="{DynamicResource 'Hide script window'}"
                                                   TextWrapping="WrapWithOverflow" 
                                                   Opacity="0.5"></TextBlock>
                                    </CheckBox>
                                </StackPanel>



                                <controls:GridWith4Columns>
                                    <TextBlock Style="{StaticResource RowHeader}" Grid.Column="0" Text="{DynamicResource 'Script after disconnected'}"></TextBlock>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Server.CommandAfterDisconnected, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                             ToolTip="{DynamicResource 'Run bat after disconnected'}"
                                             Tag="{DynamicResource 'Run bat after disconnected'}"></TextBox>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Margin="5 0 0 0" 
                                                VerticalAlignment="Stretch"
                                                Command="{Binding CmdSelectScript}" CommandParameter="after"
                                                Style="{StaticResource ButtonPrimaryStyle}" 
                                                Content="{DynamicResource Select}"></Button>

                                        <Button Margin="5 0 0 0" 
                                                VerticalAlignment="Stretch"
                                                Command="{Binding CmdTestScript}" CommandParameter="after"
                                                Style="{StaticResource ButtonPrimaryStyle}" 
                                                Content="{DynamicResource Test}"></Button>
                                    </StackPanel>
                                </controls:GridWith4Columns>


</StackPanel>
</Expander>
<Expander Style="{StaticResource EditorAccordion}" Header="{DynamicResource editor_section_look}" editor:AccordionHelper.Properties="Tags">
<StackPanel>
<controls:GridWith4Columns>
                                    <TextBlock Style="{StaticResource RowHeader}" Grid.Column="0" Text="{DynamicResource Icon}"></TextBlock>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
