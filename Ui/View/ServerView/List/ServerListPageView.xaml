<serverView:ServerViewBase x:Class="Lemora.View.ServerView.ServerListPageView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:system="clr-namespace:System;assembly=mscorlib"
                xmlns:view="clr-namespace:Lemora.View"
                xmlns:controls="clr-namespace:Lemora.Controls"
                xmlns:controls1="clr-namespace:Shawn.Utils.Wpf.Controls;assembly=Shawn.Utils.Wpf"
                xmlns:model="clr-namespace:Lemora.Model"
                xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources"
                xmlns:s="https://github.com/canton7/Stylet"
                xmlns:controls2="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
                xmlns:serverView="clr-namespace:Lemora.View.ServerView"
                xmlns:dao="clr-namespace:Lemora.Service.DataSource.DAO"
                xmlns:locality="clr-namespace:Lemora.Service.Locality"
                mc:Ignorable="d"
                d:DataContext="{d:DesignInstance serverView:ServerListPageViewModel}"
                d:DesignHeight="450" d:DesignWidth="800">
    <serverView:ServerViewBase.Resources>
        <ResourceDictionary>
            <CollectionViewSource x:Key="ServerListItemSource" 
                                  Source="{Binding VmServerList}"
                                  Filter="ServerListItemSource_OnFilter">
            </CollectionViewSource>


            <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource ExpanderWithAnEye}"></Style>



            <system:Double x:Key="ServerItemHeight">54</system:Double>



            <Style TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid Name="Grid" FocusVisualStyle="{x:Null}" 
                                  PreviewMouseDown="ServerList_OnPreviewMouseDown"
                                  Background="{DynamicResource BackgroundBrush}"
                                  Visibility="{Binding Server.Id, Converter={StaticResource ConverterEqual2Collapsed}, ConverterParameter='0'}">

                                <Border x:Name="GridContainer"></Border>
                                <ContentPresenter Content="{TemplateBinding ContentControl.Content}"
                                                  ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!--drop effect-->
                <Setter Property="AllowDrop" Value="true"/>
                <EventSetter Event="MouseMove" Handler="ServerList_PreviewMouseMoveEvent"/>
                <EventSetter Event="Drop" Handler="ServerList_OnDrop"/>
                <!--drop end event-->
            </Style>

            <DataTemplate x:Key="DataTemplateForServerCards" DataType="view:ProtocolBaseViewModel">
                <!-- tasto destro: menu della voce (lo stesso di List e Albero), prima apriva direttamente Modifica -->
                <Grid Visibility="{Binding IsVisible, Converter={StaticResource ConverterBool2Visible}}"
                      Height="164" Width="165" MouseRightButtonUp="ServerRow_OnRightClick">
                    <Grid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding CmdConnServer}"></MouseBinding>
                    </Grid.InputBindings>
                    <controls:ServerCardItem ProtocolBaseViewModel="{Binding}">
                    </controls:ServerCardItem>
                </Grid>
            </DataTemplate>


            <DataTemplate x:Key="DataTemplateForServerList" DataType="view:ProtocolBaseViewModel">
                <!-- tasto destro: menu della voce (lo stesso di Card e Albero), prima apriva direttamente Modifica -->
                <Grid Name="Grid" FocusVisualStyle="{x:Null}" Background="{DynamicResource BackgroundBrush}" MouseRightButtonUp="ServerRow_OnRightClick">
                    <Grid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding CmdConnServer}"></MouseBinding>
                    </Grid.InputBindings>
                    <Border x:Name="GridContainer"></Border>
                    <controls:ServerLineItem ProtocolBaseViewModel="{Binding}" 
                                             MinHeight="{StaticResource ServerItemHeight}"
                                             Visibility="{Binding IsVisible, Converter={StaticResource ConverterBool2Visible}}"
                                             ></controls:ServerLineItem>
                </Grid>
                <DataTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" TargetName="GridContainer" Value="{DynamicResource IslandHoverBrush}"></Setter>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="ServerListStyle" TargetType="ListBox">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="ItemTemplate" Value="{StaticResource DataTemplateForServerList}"></Setter>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True"
                                                    ScrollUnit="Pixel"
                                                    VirtualizationMode="Recycling"
                                                    CacheLengthUnit="Item"
                                                    Margin="0 0 0 30"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>

                <Setter Property="Margin">
                    <Setter.Value>
                        <Thickness Top="0"></Thickness>
                    </Setter.Value>
                </Setter>

                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentViewInListPage}" Value="{x:Static view:EnumServerViewStatus.Card}">
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <controls2:VirtualizingWrapPanel IsVirtualizing="True"
                                                                     ScrollUnit="Item"
                                                                     SpacingMode="None"
                                                                     Margin="15 10 0 20"
                                                                     Width="{Binding RelativeSource={RelativeSource FindAncestor,AncestorType=ListBox}, Path=ActualWidth}"></controls2:VirtualizingWrapPanel>
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ItemTemplate" Value="{StaticResource DataTemplateForServerCards}"></Setter>
                        <Setter Property="Margin" Value="0"></Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- barra delle cartelle a sole icone (finestra media): testi nascosti, icone visibili -->
            <Style x:Key="NavTextOnly" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding LayoutMode}" Value="Medium"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NavIconOnly" TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource AccentMidBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding LayoutMode}" Value="Medium"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                </Style.Triggers>
            </Style>
            <serverView:NameMaxWidthConverter x:Key="NameMaxWidthConverter" />
            <serverView:NoteMaxWidthConverter x:Key="NoteMaxWidthConverter" />
        </ResourceDictionary>
    </serverView:ServerViewBase.Resources>






    <!-- Restyle "Fluent Islands": frame scuro, barra strumenti, tre isole (navigazione, lista, dettaglio) -->
    <Grid Background="{DynamicResource PrimaryDarkBrush}" Grid.IsSharedSizeScope="True">
        <Grid Margin="6 0 6 6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <!-- barra strumenti -->
            <Border Grid.Row="0" Margin="0 0 0 6" Padding="10 0" Height="54"
                    Background="{DynamicResource PrimaryMidBrush}"
                    BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource IslandRadius}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- finestra stretta: le cartelle stanno in un menu a scomparsa che si apre da qui (la ricerca si sposta a destra) -->
                    <Button x:Name="BtnNavMenu" Grid.Column="0" Width="34" Height="34" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Style="{StaticResource BtnSecondary}" Click="NavMenu_OnClick" Visibility="Collapsed" ToolTip="{DynamicResource home_folders_menu}">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <!-- "Aggiungi" diviso in due: a sinistra apre la creazione, la freccia apre le altre opzioni (importazioni).
                         Il margine sinistro lo calcola la vista: subito a destra della ricerca, che si allarga e si stringe con la finestra -->
                    <StackPanel x:Name="AddBox" Grid.Column="0" Orientation="Horizontal" Height="34" Margin="453 0 0 0" VerticalAlignment="Center">
                        <Button Style="{x:Null}" Command="{Binding CmdAdd}" Cursor="Hand" Focusable="False" FocusVisualStyle="{x:Null}" ToolTip="{DynamicResource Add}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{DynamicResource AccentMidBrush}" CornerRadius="4 0 0 4" Padding="16 0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeometryCross}" Stretch="Uniform" Width="12" Height="12" Fill="{DynamicResource AccentTextBrush}" />
                                            <TextBlock x:Name="AddText" Text="{DynamicResource Add}" Margin="10 0 0 0" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="AddShortcut" Text="Ctrl+N" Margin="12 1 0 0" FontSize="{DynamicResource GlobalFontSizeSmall}" Foreground="{DynamicResource AccentTextBrush}" Opacity="0.65" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- la scorciatoia solo con la finestra larga; con la finestra quadrata resta solo il + -->
                                        <DataTrigger Binding="{Binding DataContext.LayoutMode, RelativeSource={RelativeSource AncestorType=serverView:ServerViewBase}}" Value="Wide">
                                            <Setter TargetName="AddShortcut" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.LayoutMode, RelativeSource={RelativeSource AncestorType=serverView:ServerViewBase}}" Value="Square">
                                            <Setter TargetName="AddText" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border Width="1" Background="{DynamicResource AccentDarkBrush}" />
                        <CheckBox Name="CbPopForInExport" Style="{x:Null}" Cursor="Hand" Focusable="False" FocusVisualStyle="{x:Null}">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border x:Name="Bd" Background="{DynamicResource AccentMidBrush}" CornerRadius="0 4 4 0" Width="30">
                                        <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>
                    </StackPanel>

                    <Popup Grid.Column="0" Name="PopupMenuInExport"
                           IsOpen="{Binding ElementName=CbPopForInExport, Path=IsChecked}"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PlacementTarget="{Binding ElementName=CbPopForInExport}">
                        <Border CornerRadius="5" Background="{DynamicResource PrimaryDarkBrush}">
                            <StackPanel Orientation="Vertical">
                                <MenuItem Header="{DynamicResource import_from_json}" Command="{Binding CmdImportFromJson}">
                                    <MenuItem.Icon>
                                        <Path UseLayoutRounding="True" Data="{StaticResource GeometryCopy}" Fill="{DynamicResource PrimaryTextBrush}" Stretch="Uniform"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource import_from_mremoteng_csv}" Command="{Binding CmdImportFromCsv}"></MenuItem>
                                <MenuItem Header="{DynamicResource import_from_rdp_file}" Command="{Binding CmdImportFromRdp}"></MenuItem>
                                <MenuItem Header="{DynamicResource import_from_sqlite_db}" Command="{Binding CmdImportFromDatabase}"></MenuItem>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- selettore vista: Lista / Card / Albero (comandi della finestra principale) -->
                    <Border x:Name="ViewSwitch" Grid.Column="2" VerticalAlignment="Center" BorderThickness="1" CornerRadius="{StaticResource IslandRadius}"
                            BorderBrush="{DynamicResource IslandButtonBorderBrush}" ClipToBounds="True">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource ListViewMode_List}"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CmdToggleListView}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BtnSegment}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CurrentView}" Value="List">
                                                <Setter Property="Tag" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{DynamicResource ListViewMode_Card}"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CmdToggleCardView}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BtnSegment}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CurrentView}" Value="Card">
                                                <Setter Property="Tag" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{DynamicResource ListViewMode_Tree}"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CmdToggleTreeView}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BtnSegment}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CurrentView}" Value="Tree">
                                                <Setter Property="Tag" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- corpo: navigazione | lista | dettaglio. Larghezze e posizione dei pannelli le imposta la vista secondo la finestra (ApplyLayout) -->
            <Grid x:Name="BodyGrid" Grid.Row="1" PreviewMouseDown="BodyGrid_OnPreviewMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColNav" Width="220" MinWidth="170" MaxWidth="420" />
                    <ColumnDefinition x:Name="ColSplitNav" Width="6" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition x:Name="ColSplitDetail" Width="6" />
                    <ColumnDefinition x:Name="ColDetail" Width="320" MinWidth="260" MaxWidth="640" />
                </Grid.ColumnDefinitions>

                <!-- finestra stretta: sfondo scuro sotto il menu a scomparsa delle cartelle; un clic lo chiude -->
                <Border x:Name="NavDim" Grid.ColumnSpan="5" Panel.ZIndex="19" Background="#8C000000" Visibility="Collapsed"
                        MouseLeftButtonDown="NavDim_OnMouseLeftButtonDown" />

                <!-- isola navigazione (piena, a sole icone o menu a scomparsa) -->
                <Border x:Name="NavIsland" Grid.Column="0" Style="{StaticResource IslandBorder}">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="6" BorderThickness="0 1 0 0" BorderBrush="{DynamicResource IslandDividerBrush}">
                            <StackPanel>
                                <Button Height="40" Command="{Binding CmdShowTagTab}" Content="{DynamicResource Tags}" Visibility="Collapsed">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnNav}">
                                            <Setter Property="Tag" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TagListViewModel}" Value="{x:Null}">
                                                    <Setter Property="Tag" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AppData.TagList.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Style="{StaticResource BtnNav}" Height="40" ToolTip="{DynamicResource Options}"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CmdGoSysOptionsPage}">
                                    <Grid>
                                        <Grid Style="{StaticResource NavTextOnly}">
                                            <TextBlock Text="{DynamicResource Options}" HorizontalAlignment="Left" />
                                            <TextBlock Text="Ctrl+I" HorizontalAlignment="Right" FontSize="{DynamicResource GlobalFontSizeSmall}" Opacity="0.55" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource NavIconOnly}" Text="&#xE713;" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="6">
                                <!-- home -->
                                <Button Command="{Binding CmdShowHome}" Click="NavPick_OnClick" ToolTip="{DynamicResource Home}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnNav}">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsHomeMode}" Value="True"/>
                                                        <Condition Binding="{Binding TagListViewModel}" Value="{x:Null}"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.Setters>
                                                        <Setter Property="Tag" Value="True" />
                                                    </MultiDataTrigger.Setters>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <TextBlock FontSize="{DynamicResource GlobalFontSizeSubtitle}" FontWeight="SemiBold" Text="{DynamicResource Home}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LayoutMode}" Value="Medium"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource NavIconOnly}" Text="&#xE80F;" />
                                    </Grid>
                                </Button>

                                

                                <!-- cartelle: albero con conteggi; menu ⋯ per rinominare, creare sottocartelle ed eliminare -->
                                <ItemsControl Name="ListBoxFolders"
                                              ItemsSource="{Binding FolderNav}"
                                              BorderThickness="0" Margin="0 4 0 0" Padding="0"
                                              Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="serverView:FolderNavItem">
                                            <Grid x:Name="Row" Background="Transparent"
                                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=serverView:ServerViewBase}}"
                                                  ContextMenuService.IsEnabled="{Binding IsReadOnly, Converter={StaticResource ConverterBoolInverse}}"
                                                  Margin="{Binding Indent}">
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <!-- cartella con voci in sola lettura: nessuna azione di scrittura (nemmeno sottocartella e "Credenziali e rete", che mostra utenti delle voci) -->
                                                        <!-- come il disegno: Rinomina, Modifica, Elimina (la sottocartella si crea dalla pagina di modifica) -->
                                                        <MenuItem Header="{DynamicResource Rename}"
                                                                  Visibility="{Binding IsReadOnly, Converter={StaticResource ConverterBool2VisibleInv}}"
                                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.Tag.CmdRenameFolder}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="{DynamicResource Edit}"
                                                                  Visibility="{Binding IsReadOnly, Converter={StaticResource ConverterBool2VisibleInv}}"
                                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.Tag.CmdFolderSettings}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Tag="danger" Header="{DynamicResource Delete}"
                                                                  Visibility="{Binding IsReadOnly, Converter={StaticResource ConverterBool2VisibleInv}}"
                                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.Tag.CmdDeleteFolder}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <Grid x:Name="NavItem" Cursor="Hand" MouseLeftButtonDown="FolderNav_OnClick">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Height" Value="38" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTop}" Value="True">
                                                                    <Setter Property="Height" Value="46" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Border x:Name="Bd" Background="{DynamicResource IslandCardBrush}" CornerRadius="{StaticResource IslandRadius}" />
                                                    <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0 8" CornerRadius="2"
                                                            Background="{DynamicResource AccentMidBrush}" Visibility="Collapsed" />
                                                    <Grid x:Name="NavInner" Margin="6 0 6 0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition x:Name="ColArrow" Width="22" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition x:Name="ColCount" Width="Auto" MinWidth="28" />
                                                            <!-- larghezza fissa anche senza ⋯ (cartelle in sola lettura): i contatori restano tutti sullo stesso bordo destro -->
                                                            <ColumnDefinition x:Name="ColMore" Width="24" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- freccia per aprire/chiudere le sottocartelle -->
                                                        <Button Style="{x:Null}" Cursor="Hand" Focusable="False" Background="Transparent" BorderThickness="0"
                                                                Visibility="{Binding HasChildren, Converter={StaticResource ConverterBool2Visible}}"
                                                                Command="{Binding DataContext.CmdToggleFolder, RelativeSource={RelativeSource AncestorType=serverView:ServerViewBase}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="Transparent">
                                                                        <Path x:Name="Arrow" Data="M 0,0 L 4,3.5 L 0,7 Z" Fill="{DynamicResource IslandSecondaryTextBrush}"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.3,0.5">
                                                                            <Path.RenderTransform>
                                                                                <RotateTransform Angle="0" />
                                                                            </Path.RenderTransform>
                                                                        </Path>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <RotateTransform Angle="90" />
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <Border Grid.Column="1" Width="24" Height="24" Background="{DynamicResource IslandAvatarBrush}" CornerRadius="{StaticResource IslandRadius}"
                                                                Visibility="{Binding IsTop, Converter={StaticResource ConverterBool2Visible}}">
                                                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Style="{StaticResource TextBlockBase}" Foreground="{DynamicResource AccentMidBrush}" />
                                                        </Border>
                                                        <Path Grid.Column="1" Width="16" Height="13" Stretch="Uniform" Fill="{DynamicResource AccentMidBrush}"
                                                              Data="M 0,2 L 0,12 L 16,12 L 16,3 L 8,3 L 6,0 L 1,0 Z"
                                                              Visibility="{Binding IsTop, Converter={StaticResource ConverterBool2VisibleInv}}" />
                                                        <TextBlock x:Name="NameText" Grid.Column="2" Margin="10 0 8 0" Text="{Binding Name}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                                                    <Setter Property="FontSize" Value="{fpx:FontPx 14.5}" />
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTop}" Value="True">
                                                                            <Setter Property="FontSize" Value="{DynamicResource GlobalFontSizeSubtitle}" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock x:Name="CountText" Grid.Column="3" Text="{Binding Count}" VerticalAlignment="Center" Margin="0 0 4 0" TextAlignment="Right"
                                                                   Style="{StaticResource TextBlockBase}" Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                                                        <!-- menu ⋯ -->
                                                        <!-- cartella in sola lettura: nessuna azione nel menu, quindi niente ⋯ e niente tasto destro (ContextMenuService.IsEnabled sulla riga) -->
                                                        <Button x:Name="MoreBtn" Grid.Column="4" Style="{x:Null}" Cursor="Hand" Focusable="False" Width="24" Height="24" Opacity="0"
                                                                Visibility="{Binding IsReadOnly, Converter={StaticResource ConverterBool2VisibleInv}}"
                                                                Background="Transparent" BorderThickness="0" Click="FolderMenu_OnClick" ToolTip="{DynamicResource More}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Mb" Background="Transparent" CornerRadius="{StaticResource IslandRadius}">
                                                                        <TextBlock Text="⋯" FontSize="{fpx:FontPx 16}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                                                    </Border>
