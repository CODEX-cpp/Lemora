                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         Style="{StaticResource ServerListStyle}">

                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="AllowDrop" Value="true"/>
                                    <!--drop end event-->
                                    <EventSetter Event="Drop" Handler="ServerList_OnDrop"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Grid>
                                                    <Expander IsExpanded="{Binding Items[0].GroupedIsExpanded, FallbackValue=False, TargetNullValue=False}"
                                                              Background="{DynamicResource BackgroundBrush}" 
                                                              Foreground="{DynamicResource BackgroundTextBrush}" 
                                                              Style="{StaticResource ExpanderWithAnEye}"
                                                              BorderThickness="0">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal" AllowDrop="True">
                                                                <CheckBox Margin="6 0 0 0" Width="20" Height="20" HorizontalAlignment="Left"
                                                                          x:Name="HeaderCheckBox" 
                                                                          Click="ItemsCheckBox_OnClick"
                                                                >
                                                                </CheckBox>


                                                                <StackPanel Background="Transparent" 
                                                                            Orientation="Horizontal">
                                                                    <!--drag this element to sort groups-->
                                                                    <Grid Background="Transparent"
                                                                          Cursor="SizeNS"
                                                                          ToolTip="Drag to reorder groups"
                                                                          PreviewMouseDown="ServerListExpanderIcon_OnPreviewMouseDown"
                                                                          PreviewMouseMove="ServerList_PreviewMouseMoveEvent">
                                                                        <Grid.Style>
                                                                            <Style TargetType="Grid">
                                                                                <Setter Property="Opacity" Value="0.2"></Setter>
                                                                                <Style.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Opacity" Value="1"></Setter>
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Grid.Style>
                                                                        <Path Fill="{DynamicResource PrimaryTextBrush}"
                                                                              Width="15" Height="15"
                                                                              Stretch="Uniform"
                                                                              Data="M108.208681 670.888449c20.874205-16.374376 50.998058-12.87451 67.372434 7.999695l124.495258 158.368968V48.03717c0-26.498991 21.499181-47.998172 47.998172-47.998171S396.072717 21.53818 396.072717 48.03717v927.964658c0 20.499219-12.999505 38.623529-32.373767 45.373272-4.99981 1.749933-10.374605 2.6249-15.624405 2.6249-14.499448 0-28.498915-6.499752-37.748562-18.3743L100.08399 738.260883C83.709614 717.511673 87.334476 687.262825 108.208681 670.888449zM634.063653 2.663899c19.249267-6.749743 40.748448-0.374986 53.372967 15.7494l210.241993 267.364817c16.374376 20.74921 12.749514 50.998058-8.12469 67.372434-20.74921 16.374376-50.998058 12.87451-67.372434-7.999695l-124.495259-158.368969v789.219942c0 26.498991-21.499181 47.998172-47.998172 47.998172s-47.998172-21.499181-47.998172-47.998172V48.03717c0.124995-20.374224 13.1245-38.623529 32.373767-45.373271z m0 0"></Path>
                                                                    </Grid>

                                                                    <TextBlock FontWeight="Bold" 
                                                                               Style="{StaticResource TextBlockBase}"
                                                                               FontSize="{DynamicResource GlobalFontSizeSubtitle}"
                                                                               Text="{Binding Path=Name}" 
                                                                               Margin="0,0,0,0"/>


                                                                    <!--Show database status-->
                                                                    <Button Margin="10 0 0 0"
                                                                            x:Name="ButtonDbStatus"
                                                                            Background="Transparent"
                                                                            attachProperty:VisionElement.BackgroundAccent="Transparent"
                                                                            attachProperty:VisionElement.BackgroundOnMouseDown="Transparent"
                                                                            Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=serverView:ServerViewBase}, Path=DataContext.CmdRefreshDataSource}"
                                                                            CommandParameter="{Binding Name}"
                                                                            ToolTip="{Binding Name.StatusInfo}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource ButtonBarAccentStyle}">
                                                                                <Setter Property="Content">
                                                                                    <Setter.Value>
                                                                                        <Path Height="20" Width="20" 
                                                                                                UseLayoutRounding="True" Stretch="Uniform">
                                                                                            <Path.Style>
                                                                                                <Style TargetType="Path">
                                                                                                    <Setter Property="Data" Value="{StaticResource GeometryCloudDisconnected}"></Setter>
                                                                                                    <Setter Property="Fill" Value="Red"></Setter>
                                                                                                    <Style.Triggers>
                                                                                                        <MultiDataTrigger>
                                                                                                            <MultiDataTrigger.Conditions>
                                                                                                                <Condition Binding="{Binding Name.Status}" Value="{x:Static dao:EnumDatabaseStatus.OK}"/>
                                                                                                                <Condition Binding="{Binding Name.IsWritable}" Value="True"/>
                                                                                                            </MultiDataTrigger.Conditions>
                                                                                                            <MultiDataTrigger.Setters>
                                                                                                                <Setter Property="Data" Value="{StaticResource GeometryCloudConnected}"></Setter>
                                                                                                                <Setter Property="Opacity" Value="0.2"></Setter>
                                                                                                                <Setter Property="Fill" Value="Green"></Setter>
                                                                                                            </MultiDataTrigger.Setters>
                                                                                                        </MultiDataTrigger>
                                                                                                        <MultiDataTrigger>
                                                                                                            <MultiDataTrigger.Conditions>
                                                                                                                <Condition Binding="{Binding Name.Status}" Value="{x:Static dao:EnumDatabaseStatus.OK}"/>
                                                                                                                <Condition Binding="{Binding Name.IsWritable}" Value="False"/>
                                                                                                            </MultiDataTrigger.Conditions>
                                                                                                            <MultiDataTrigger.Setters>
                                                                                                                <Setter Property="Data" Value="{StaticResource GeometryCloudConnectedReadonly}"></Setter>
                                                                                                                <Setter Property="Opacity" Value="0.2"></Setter>
                                                                                                                <Setter Property="Fill" Value="Green"></Setter>
                                                                                                            </MultiDataTrigger.Setters>
                                                                                                        </MultiDataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </Path.Style>
                                                                                        </Path>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <Style.Triggers>
                                                                                    <!--Show reconnect button when hover-->
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Content">
                                                                                            <Setter.Value>
                                                                                                <Grid Height="20" Width="20" >
                                                                                                    <Path Height="16" Width="16" UseLayoutRounding="True" Stretch="Uniform">
                                                                                                        <Path.Style>
                                                                                                            <Style TargetType="Path">
                                                                                                                <Setter Property="Data" Value="{StaticResource GeometryRefresh}"></Setter>
                                                                                                                <Setter Property="Fill" Value="{DynamicResource PrimaryTextBrush}"></Setter>
                                                                                                            </Style>
                                                                                                        </Path.Style>
                                                                                                    </Path>
                                                                                                </Grid>
                                                                                            </Setter.Value>
                                                                                        </Setter>
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>


                                                                    <Button Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=serverView:ServerViewBase}, Path=DataContext.CmdAdd}"
                                                                            CommandParameter="{Binding Name}"
                                                                            IsEnabled="{Binding Name.IsWritable}"
                                                                            Visibility="{Binding Name.Status, Converter={StaticResource ConverterEqual2Visible}, ConverterParameter={x:Static dao:EnumDatabaseStatus.OK}}"
                                                                            Background="Transparent"
                                                                            Margin="5 0 0 0"
                                                                            attachProperty:VisionElement.BackgroundAccent="Transparent"
                                                                            attachProperty:VisionElement.BackgroundOnMouseDown="Transparent"
                                                                            Style="{StaticResource ButtonBarAccentStyle}">
                                                                        <Grid Height="12" Width="12" >
                                                                            <Path Data="{StaticResource GeometryCross}" 
                                                                                  Stretch="Uniform" Name="Path"
                                                                                  Height="12" Width="12" 
                                                                                  Fill="{DynamicResource PrimaryTextBrush}">
                                                                                <Path.Style>
                                                                                    <Style TargetType="Path">
                                                                                        <Setter Property="Opacity" Value="0.5"></Setter>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=IsMouseOver}" Value="True">
                                                                                                <Setter Property="Opacity" Value="1"></Setter>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Path.Style>
                                                                            </Path>
                                                                        </Grid>
                                                                    </Button>


                                                                    <!--Show reconnect info if lost connect-->
                                                                    <TextBlock FontSize="{DynamicResource GlobalFontSizeBody}" Margin="5 0 0 0" 
                                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                                               Opacity="0.5"
                                                                               VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding Name.ReconnectInfo}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                                                                <Setter Property="Visibility" Value="Collapsed"></Setter>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Name.Status, Converter={StaticResource ConverterIsEqual2Static}, ConverterParameter={x:Static dao:EnumDatabaseStatus.OK}}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Visible"></Setter>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding ElementName=ButtonDbStatus, Path=IsMouseOver}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"></Setter>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <Expander.Content>
                                                            <ItemsPresenter />
                                                        </Expander.Content>
                                                    </Expander>

                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>


                <!-- home: preferiti e cronologia -->
                <ScrollViewer Name="HomeView" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsHomeMode, Converter={StaticResource ConverterBool2Visible}}">
                    <StackPanel Margin="0 0 0 16">
                        <StackPanel.Resources>
                            <Style x:Key="HomeSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                <Setter Property="Foreground" Value="{DynamicResource AccentMidBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="{DynamicResource GlobalFontSizeSmall}" />
                                <Setter Property="Margin" Value="18 20 0 8" />
                            </Style>
                            <DataTemplate x:Key="HomeItemTemplate" DataType="{x:Type serverView:HomeItem}">
                                <Grid x:Name="Row" MinHeight="54" Background="Transparent" Cursor="Hand"
                                      MouseLeftButtonDown="HomeItem_OnMouseDown">
                                    <Border x:Name="Hover" Visibility="Collapsed" Background="{DynamicResource IslandHoverBrush}" />
                                    <Border x:Name="SelBar" Visibility="Collapsed" Width="3" HorizontalAlignment="Left" Background="{DynamicResource AccentMidBrush}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <!-- stella cliccabile: vuota scura, piena se preferito (server salvati e connessioni rapide) -->
                                        <CheckBox Style="{StaticResource IslandStarCheckBox}" Margin="12 0 0 0" HorizontalAlignment="Left" ToolTip="{DynamicResource home_fav_tip}"
                                                  IsChecked="{Binding IsFavorite, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProtocolUpper}" FontWeight="Bold" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource GlobalFontSizeBody}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                                    <Setter Property="Foreground" Value="{DynamicResource ProtocolOtherBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProtocolUpper}" Value="RDP"><Setter Property="Foreground" Value="{DynamicResource ProtocolRdpBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding ProtocolUpper}" Value="SSH"><Setter Property="Foreground" Value="{DynamicResource ProtocolSshBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding ProtocolUpper}" Value="VNC"><Setter Property="Foreground" Value="{DynamicResource ProtocolVncBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding ProtocolUpper}" Value="SFTP"><Setter Property="Foreground" Value="{DynamicResource ProtocolSftpBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="2" Margin="0 0 12 0" VerticalAlignment="Center">
                                            <!-- nuvola Teams subito a destra del nome -->
                                            <DockPanel HorizontalAlignment="Left">
                                                <TextBlock DockPanel.Dock="Right" Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="4 1 0 0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentMidBrush}" Background="Transparent"
                                                           Visibility="{Binding Server.IsTeamsPending, Converter={StaticResource ConverterBool2Visible}, FallbackValue=Collapsed}"
                                                           ToolTip="{DynamicResource teams_pending_tip}" AutomationProperties.Name="{DynamicResource teams_pending_tip}" />
                                                <TextBlock DockPanel.Dock="Right" Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="6 1 0 0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentMidBrush}" Background="Transparent"
                                                           Visibility="{Binding Server.IsTeams, Converter={StaticResource ConverterBool2Visible}, FallbackValue=Collapsed}"
                                                           ToolTip="{DynamicResource teams_shared_tip}" AutomationProperties.Name="{DynamicResource teams_shared_tip}" />
                                                <TextBlock Style="{StaticResource TextBlockBase}" FontSize="{DynamicResource GlobalFontSizeSubtitle}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" Text="{Binding DisplayTitle}" />
                                            </DockPanel>
                                            <TextBlock x:Name="HostLine" Style="{StaticResource TextBlockBase}" FontSize="{DynamicResource GlobalFontSizeSmall}"
                                                       Foreground="{DynamicResource IslandSecondaryTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding HostText}" />
                                        </StackPanel>
                                        <!-- utente (testo o menu a tendina): sparisce con la finestra quadrata, si legge nel dettaglio -->
                                        <Grid x:Name="UserCol" Grid.Column="3">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="{DynamicResource GlobalFontSizeBody}" Text="{Binding UserText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasUserChoices}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- piu' utenti: menu a tendina per scegliere quello predefinito -->
                                        <Button Style="{StaticResource BtnSecondary}" Height="28" Padding="10 0" VerticalAlignment="Center" Click="HomeUser_OnClick"
                                                Visibility="{Binding HasUserChoices, Converter={StaticResource ConverterBool2Visible}}"
                                                AutomationProperties.AutomationId="HomeUserDropdown">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding UserLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Margin="8 1 0 0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        </Grid>
                                        <!-- separatore: a sinistra il clic collega, a destra (DetailsZone) apre i dettagli nel pannello laterale -->
                                        <Border Grid.Column="4" Width="1" Margin="16 12 0 12" Background="{DynamicResource IslandSecondaryTextBrush}" Opacity="0.45" IsHitTestVisible="False" />
                                        <Border x:Name="DetailsZone" Grid.Column="5" Background="Transparent" ToolTip="{DynamicResource home_details}">
                                            <Path Data="M 0,0 L 4,4 L 0,8" Stroke="{DynamicResource IslandSecondaryTextBrush}" StrokeThickness="1.5"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                        </Border>
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource IslandDividerBrush}" BorderThickness="0 0 0 1" VerticalAlignment="Bottom" Height="1" IsHitTestVisible="False" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="SelBar" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <!-- finestra piccola: una riga (protocollo, nome, utente); quadrata: nome e indirizzo, senza utente -->
                                    <DataTrigger Binding="{Binding DataContext.LayoutMode, RelativeSource={RelativeSource AncestorType=serverView:ServerViewBase}}" Value="Small">
                                        <Setter TargetName="HostLine" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.LayoutMode, RelativeSource={RelativeSource AncestorType=serverView:ServerViewBase}}" Value="Square">
                                        <Setter TargetName="UserCol" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </StackPanel.Resources>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FavoriteItems.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource HomeSectionTitle}" Text="&#9733;" Margin="18 20 6 8" />
                            <TextBlock Style="{StaticResource HomeSectionTitle}" Text="{DynamicResource home_favorites}" Margin="0 20 0 8" />
                        </StackPanel>
                        <ItemsControl x:Name="HomeFavList" ItemsSource="{Binding FavoriteItems}" ItemTemplate="{StaticResource HomeItemTemplate}" Focusable="False" />

                        <TextBlock Text="{DynamicResource home_history}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HomeSectionTitle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HistoryItems.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl x:Name="HomeHistoryList" ItemsSource="{Binding HistoryItems}" ItemTemplate="{StaticResource HomeItemTemplate}" Focusable="False" />

                        <TextBlock Text="{DynamicResource home_servers}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HomeSectionTitle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OtherItems.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl x:Name="HomeOtherList" ItemsSource="{Binding OtherItems}" ItemTemplate="{StaticResource HomeItemTemplate}" Focusable="False" />

                        <!-- Home vuota (profilo nuovo): un invito al posto delle sezioni senza voci -->
                        <StackPanel Margin="24 56 24 0" HorizontalAlignment="Center" MaxWidth="460">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding FavoriteItems.Count}" Value="0" />
                                                <Condition Binding="{Binding HistoryItems.Count}" Value="0" />
                                                <Condition Binding="{Binding OtherItems.Count}" Value="0" />
                                                <Condition Binding="{Binding HomeIsFiltering}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource TextBlockBase}" FontSize="{DynamicResource GlobalFontSizeSubtitle}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="{DynamicResource home_empty_title}" />
                            <TextBlock Style="{StaticResource TextBlockBase}" FontSize="{DynamicResource GlobalFontSizeBody}" TextAlignment="Center" TextWrapping="Wrap" Margin="0 10 0 0"
                                       Foreground="{DynamicResource IslandSecondaryTextBrush}" Text="{DynamicResource home_empty_body}" />
                        </StackPanel>

                        <!-- ricerca senza risultati: Invio collega direttamente a quello che e' stato scritto -->
                        <StackPanel Margin="24 56 24 0" HorizontalAlignment="Center" MaxWidth="460">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding FavoriteItems.Count}" Value="0" />
                                                <Condition Binding="{Binding HistoryItems.Count}" Value="0" />
                                                <Condition Binding="{Binding OtherItems.Count}" Value="0" />
                                                <Condition Binding="{Binding HomeIsFiltering}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource TextBlockBase}" FontSize="{DynamicResource GlobalFontSizeBody}" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource IslandSecondaryTextBrush}" Text="{DynamicResource home_nomatch}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- footer: show detail of a server -->
                <Grid Name="GridBottom" VerticalAlignment="Bottom" Height="0" Background="{DynamicResource PrimaryMidBrush}" IsHitTestVisible="False">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="0.9"></Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedServerViewModel}" Value="{x:Null}">
                                    <Setter Property="Opacity" Value="0"></Setter>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0"></Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"></Setter>
                                <Setter Property="Margin" Value="0 0 5 0"></Setter>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="{Binding SelectedServerViewModel.Server.DisplayName}" Style="{StaticResource TextBlockBase}" Margin="5 0"></TextBlock>
                        <TextBlock Text="{Binding SelectedServerViewModel.Server.SubTitle}" Style="{StaticResource TextBlockBase}"></TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>


            <!-- popup when any item is selected-->
            <Grid Grid.Row="2" Background="{DynamicResource PrimaryMidBrush}" Height="40">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"></Setter>
                        <Setter Property="Margin" Value="0 0 0 -50"></Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAnySelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible"></Setter>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimationUsingKeyFrames BeginTime="0:0:0" Storyboard.TargetProperty="Margin" AccelerationRatio="0.9">
                                                <SplineThicknessKeyFrame KeyTime="0:0:0.0" Value="0,0,0,-50" />
                                                <SplineThicknessKeyFrame KeyTime="0:0:0.400" Value="0,0,0,0" />
                                            </ThicknessAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimationUsingKeyFrames BeginTime="0:0:0" Storyboard.TargetProperty="Margin">
                                                <SplineThicknessKeyFrame KeyTime="0:0:0.0" Value="0,0,0,0" />
                                                <SplineThicknessKeyFrame KeyTime="0:0:0.200" Value="0,0,0,-50" />
                                            </ThicknessAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- due colonne: i pulsanti a destra restano interi, con la finestra stretta si accorcia il testo "elementi selezionati" (prima i pulsanti coprivano "Annulla") -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" ClipToBounds="True">
                    <Button Height="30" MinWidth="80" Margin="5 0" Content="{DynamicResource Cancel}" Command="{Binding CmdCancelSelected}"></Button>
                    <TextBlock Style="{StaticResource TextBlockBase}" Text="{DynamicResource server_editor_multi_selected_count}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"></TextBlock>
                    <TextBlock Style="{StaticResource TextBlockBase}" Text="{Binding SelectedCount}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="5 0 0 0"></TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel.Resources>
                        <!-- Modifica/Elimina: nascosti se la selezione contiene voci in sola lettura (CanExecute falso) -->
                        <Style x:Key="BtnHideDisabled" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>
                    <Button Height="30" MinWidth="80" Margin="5 0 0 0" Content="{DynamicResource Connect}" Command="{Binding CmdConnectSelected}"></Button>
                    <Button Style="{StaticResource BtnHideDisabled}" Height="30" MinWidth="80" Margin="5 0 0 0" Content="{DynamicResource Edit}" Command="{Binding CmdMultiEditSelected}"></Button>
                    <Button Height="30" MinWidth="80" Margin="5 0 0 0" Content="{DynamicResource 'Create desktop shortcut'}" Command="{Binding CmdCreateDesktopShortcut}"></Button>
                    <Button Style="{StaticResource BtnHideDisabled}" Height="30" MinWidth="80" Margin="5 0 0 0" Content="{DynamicResource Delete}" Command="{Binding CmdDeleteSelected}"></Button>
                    <Button Style="{StaticResource BtnHideDisabled}" Height="30" MinWidth="80" Margin="5 0" Content="{DynamicResource Export}" Command="{Binding CmdExportSelectedToJson}"></Button>
                </StackPanel>
            </Grid>
        </Grid>







                </Border>

                <GridSplitter x:Name="SplitDetail" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

                <!-- elenco dei tag (gestione): copre lista e dettaglio, la navigazione resta visibile -->
                <ContentControl Grid.Column="2" Grid.ColumnSpan="3" Panel.ZIndex="5"
                                s:View.Model="{Binding TagListViewModel}"
                                Visibility="{Binding TagListViewModel, 
                                                    Converter={StaticResource ConverterEqual2Collapsed}, 
                                                    ConverterParameter={x:Null}}">
                </ContentControl>

                <!-- pagina di modifica cartella: come l'elenco dei tag, copre lista e dettaglio e lascia visibile la navigazione -->
                <ContentControl Grid.Column="2" Grid.ColumnSpan="3" Panel.ZIndex="6"
                                s:View.Model="{Binding FolderEditViewModel}"
                                Visibility="{Binding FolderEditViewModel, Converter={StaticResource ConverterEqual2Collapsed}, ConverterParameter={x:Null}}" />

                <!-- isola dettaglio: ultimo server su cui si e' cliccato (fisso, sovrapposto alla lista o al suo posto: vedi ApplyLayout) -->
                <Border x:Name="DetailIsland" Grid.Column="4" Style="{StaticResource IslandBorder}">
                  <Grid x:Name="DetailGrid">
                    <!-- finestra quadrata: il dettaglio prende il posto della lista, da qui si torna alla Home -->
                    <Button x:Name="DetailBack" Panel.ZIndex="2" Style="{StaticResource BtnNav}" Height="30" Padding="10 0" Margin="10 8 0 0"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" Click="DetailBack_OnClick">
                        <TextBlock Style="{StaticResource TextBlockBase}" Foreground="{DynamicResource AccentMidBrush}" VerticalAlignment="Center">
                            <Run Text="&#8592; " /><Run Text="{DynamicResource Home}" />
                        </TextBlock>
                    </Button>
                    <!-- riepilogo della cartella scelta (sola lettura): + Server, Modifica, tabella Rete/Dominio/Server/Sottocartelle, credenziali e password condivise -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding FolderSummary, Converter={StaticResource ConverterEqual2Collapsed}, ConverterParameter={x:Null}}">
                        <StackPanel Margin="20" DataContext="{Binding FolderSummary}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" Background="{DynamicResource PrimaryDarkBrush}" BorderThickness="1"
                                        BorderBrush="{DynamicResource IslandBorderBrush}" CornerRadius="{StaticResource IslandRadius}">
                                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="{fpx:FontPx 18}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Style="{StaticResource TextBlockBase}" Foreground="{DynamicResource AccentMidBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14 0 0 0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TextBlockBase}" FontSize="{fpx:FontPx 20}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TextBlockBase}" Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0 16 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource BtnPrimary}" Command="{Binding CmdAddServer}" Content="{Binding Tx[fs_add_server]}" />
                                <Button Grid.Column="1" Margin="8 0 0 0" Padding="18 0" Style="{StaticResource BtnSecondary}" Command="{Binding CmdEdit}" Content="{Binding Tx[fs_edit]}" />
                            </Grid>
                            <Border Margin="0 14 0 0" Background="{DynamicResource IslandHoverBrush}" BorderBrush="{DynamicResource IslandDividerBrush}" BorderThickness="1" CornerRadius="{StaticResource IslandRadius}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38" /><RowDefinition Height="38" /><RowDefinition Height="38" /><RowDefinition Height="38" /><RowDefinition Height="38" /><RowDefinition Height="38" />
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style x:Key="SumLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                            <Setter Property="Margin" Value="12 0 18 0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="{DynamicResource IslandSecondaryTextBrush}" />
                                        </Style>
                                        <Style x:Key="SumValue" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                            <Setter Property="Grid.Column" Value="1" />
                                            <Setter Property="Margin" Value="0 0 12 0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </Grid.Resources>
                                    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="0 1 0 0" BorderBrush="{DynamicResource IslandDividerBrush}" />
                                    <Border Grid.Row="2" Grid.ColumnSpan="2" BorderThickness="0 1 0 0" BorderBrush="{DynamicResource IslandDividerBrush}" />
                                    <Border Grid.Row="3" Grid.ColumnSpan="2" BorderThickness="0 1 0 0" BorderBrush="{DynamicResource IslandDividerBrush}" />
                                    <Border Grid.Row="4" Grid.ColumnSpan="2" BorderThickness="0 1 0 0" BorderBrush="{DynamicResource IslandDividerBrush}" />
                                    <Border Grid.Row="5" Grid.ColumnSpan="2" BorderThickness="0 1 0 0" BorderBrush="{DynamicResource IslandDividerBrush}" />
                                    <TextBlock Grid.Row="0" Style="{StaticResource SumLabel}" Text="{Binding Tx[fs_network]}" />
                                    <TextBlock Grid.Row="0" Style="{StaticResource SumValue}" FontFamily="Consolas" FontSize="{fpx:FontPx 14}" FontWeight="SemiBold" Text="{Binding Network}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource SumLabel}" Text="{Binding Tx[fs_domain]}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource SumValue}" Text="{Binding Domain}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource SumLabel}" Text="{Binding Tx[fs_servers]}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource SumValue}" Text="{Binding ServerCount}" />
                                    <TextBlock Grid.Row="3" Style="{StaticResource SumLabel}" Text="{Binding Tx[fs_subfolders]}" />
                                    <TextBlock Grid.Row="3" Style="{StaticResource SumValue}" Text="{Binding SubfolderCount}" />
                                    <TextBlock Grid.Row="4" Style="{StaticResource SumLabel}" Text="{Binding Tx[fs_creds_row]}" />
                                    <TextBlock Grid.Row="4" Style="{StaticResource SumValue}" Text="{Binding CredentialsCount}" />
                                    <TextBlock Grid.Row="5" Style="{StaticResource SumLabel}" Text="{Binding Tx[fs_devices_row]}" />
                                    <TextBlock Grid.Row="5" Style="{StaticResource SumValue}" Text="{Binding DevicesCount}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding DetailServerViewModel, Converter={StaticResource ConverterEqual2Collapsed}, ConverterParameter={x:Null}}">
                        <StackPanel Margin="20" DataContext="{Binding DetailServerViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" Background="{DynamicResource PrimaryDarkBrush}" BorderThickness="1"
                                        BorderBrush="{DynamicResource IslandBorderBrush}" CornerRadius="{StaticResource IslandRadius}">
                                    <TextBlock Text="{Binding Server.ProtocolDisplayName}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                                <Setter Property="Foreground" Value="{DynamicResource ProtocolOtherBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Server.ProtocolDisplayName}" Value="RDP"><Setter Property="Foreground" Value="{DynamicResource ProtocolRdpBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Server.ProtocolDisplayName}" Value="SSH"><Setter Property="Foreground" Value="{DynamicResource ProtocolSshBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Server.ProtocolDisplayName}" Value="VNC"><Setter Property="Foreground" Value="{DynamicResource ProtocolVncBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Server.ProtocolDisplayName}" Value="SFTP"><Setter Property="Foreground" Value="{DynamicResource ProtocolSftpBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14 0 0 0" VerticalAlignment="Center">
                                    <!-- nome e, subito a destra, la nuvola delle voci Teams -->
                                    <DockPanel HorizontalAlignment="Left">
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Margin="6 2 0 0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentMidBrush}" Background="Transparent"
                                                   Visibility="{Binding IsTeamsPending, Converter={StaticResource ConverterBool2Visible}, FallbackValue=Collapsed}"
                                                   ToolTip="{DynamicResource teams_pending_tip}" AutomationProperties.Name="{DynamicResource teams_pending_tip}" />
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Margin="8 2 0 0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentMidBrush}" Background="Transparent"
                                                   Visibility="{Binding IsTeams, Converter={StaticResource ConverterBool2Visible}, FallbackValue=Collapsed}"
                                                   ToolTip="{DynamicResource teams_shared_tip}" AutomationProperties.Name="{DynamicResource teams_shared_tip}" />
                                        <TextBox Text="{Binding Server.DisplayName, Mode=OneWay}" Style="{StaticResource SelectableText}" TextWrapping="NoWrap"
                                                 FontSize="{fpx:FontPx 22}" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Server.Note}" Style="{StaticResource TextBlockBase}" MaxHeight="20"
                                               Foreground="{DynamicResource IslandSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <!-- azioni: Connetti (con le varianti nella freccia), poi Modifica, Duplica, Copia, Altro, Elimina -->
                            <Grid Margin="0 18 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource BtnPrimary}" Command="{Binding CmdConnServer}" Content="{DynamicResource Connect}" />
                                <CheckBox x:Name="CbConnectMore" Grid.Column="1" Margin="6 0 0 0" Style="{StaticResource BtnDropdownIcon}"
                                          ToolTip="{DynamicResource Connect}"
                                          Visibility="{Binding DetailActionSet.HasConnectActions, Converter={StaticResource ConverterBool2Visible}}" />
                                <Popup Grid.Column="1" IsOpen="{Binding ElementName=CbConnectMore, Path=IsChecked}" StaysOpen="False" AllowsTransparency="True"
                                       Placement="Bottom" PlacementTarget="{Binding ElementName=CbConnectMore}">
                                    <Border Margin="0 4 0 0" Padding="4" MinWidth="220" Background="{DynamicResource PrimaryDarkBrush}"
                                            BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource IslandRadius}">
                                        <ItemsControl ItemsSource="{Binding DetailActionSet.ConnectActions, Mode=OneWay}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource BtnNav}" Height="34" HorizontalContentAlignment="Left"
                                                            Content="{Binding ActionName}" CommandParameter="{Binding}" Click="DetailAction_OnClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                            </Grid>

                            <WrapPanel Margin="0 8 0 0">
                                <!-- nascosto se l'origine e' in sola lettura (CanExecute di CmdEditServer): senza permesso il pulsante non si mostra -->
                                <Button Margin="0 0 6 6" Command="{Binding CmdEditServer}" Content="{DynamicResource Edit}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Style="{StaticResource BtnSecondary}" Margin="0 0 6 6" Content="{DynamicResource Duplicate}"
                                        CommandParameter="{Binding DetailActionSet.Duplicate}" Click="DetailAction_OnClick"
                                        Visibility="{Binding DetailActionSet.HasDuplicate, Converter={StaticResource ConverterBool2Visible}}" />
                                <Grid Margin="0 0 6 6" Visibility="{Binding DetailActionSet.HasCopyActions, Converter={StaticResource ConverterBool2Visible}}">
                                    <CheckBox x:Name="CbCopyMore" Style="{StaticResource BtnDropdown}" Content="{DynamicResource Copy}" />
                                <Popup IsOpen="{Binding ElementName=CbCopyMore, Path=IsChecked}" StaysOpen="False" AllowsTransparency="True"
                                       Placement="Bottom" PlacementTarget="{Binding ElementName=CbCopyMore}">
                                    <Border Margin="0 4 0 0" Padding="4" MinWidth="220" Background="{DynamicResource PrimaryDarkBrush}"
                                            BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource IslandRadius}">
                                        <ItemsControl ItemsSource="{Binding DetailActionSet.CopyActions, Mode=OneWay}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource BtnNav}" Height="34" HorizontalContentAlignment="Left"
                                                            Content="{Binding ActionName}" CommandParameter="{Binding}" Click="DetailAction_OnClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                                </Grid>
                                <Grid Margin="0 0 6 6" Visibility="{Binding DetailActionSet.HasExportActions, Converter={StaticResource ConverterBool2Visible}}">
                                    <CheckBox x:Name="CbOtherMore" Style="{StaticResource BtnDropdown}" Content="{Binding DetailActionSet.ExportLabel}" />
                                <Popup IsOpen="{Binding ElementName=CbOtherMore, Path=IsChecked}" StaysOpen="False" AllowsTransparency="True"
                                       Placement="Bottom" PlacementTarget="{Binding ElementName=CbOtherMore}">
                                    <Border Margin="0 4 0 0" Padding="4" MinWidth="220" Background="{DynamicResource PrimaryDarkBrush}"
                                            BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource IslandRadius}">
                                        <ItemsControl ItemsSource="{Binding DetailActionSet.ExportActions, Mode=OneWay}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource BtnNav}" Height="34" HorizontalContentAlignment="Left"
                                                            Content="{Binding ActionName}" CommandParameter="{Binding}" Click="DetailAction_OnClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                                </Grid>
                                <Button Style="{StaticResource BtnDanger}" Margin="0 0 6 6" Content="{DynamicResource Delete}"
                                        CommandParameter="{Binding DetailActionSet.Delete}" Click="DetailAction_OnClick"
                                        Visibility="{Binding DetailActionSet.HasDelete, Converter={StaticResource ConverterBool2Visible}}" />
                            </WrapPanel>

                            <!-- riquadro incassato con i dati della connessione -->
                            <Border Margin="0 8 0 0" Background="{DynamicResource PrimaryDarkBrush}" BorderThickness="1"
                                    BorderBrush="{DynamicResource IslandBorderBrush}" CornerRadius="{StaticResource IslandRadius}">
                                <StackPanel>
                                    <StackPanel.Resources>
                                        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                            <Setter Property="Foreground" Value="{DynamicResource IslandSecondaryTextBrush}" />
                                            <Setter Property="VerticalAlignment" Value="Top" />
                                        </Style>
                                        <Style x:Key="DetailValue" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="VerticalAlignment" Value="Top" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <Grid Margin="16 12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource Target}" />
                                        <TextBox Grid.Column="1" Style="{StaticResource SelectableText}" Text="{Binding HostText, Mode=OneWay}" />
                                    </Grid>
                                    <Border BorderThickness="0 1 0 0" BorderBrush="{DynamicResource IslandDividerBrush}" />
                                    <Grid Margin="16 12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource User}" />
                                        <TextBox Grid.Column="1" Style="{StaticResource SelectableText}" Text="{Binding AllUsersText, Mode=OneWay}" />
                                    </Grid>
                                    <Border BorderThickness="0 1 0 0" BorderBrush="{DynamicResource IslandDividerBrush}" />
                                    <Grid Margin="16 12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource Protocol}" />
                                        <TextBox Grid.Column="1" Style="{StaticResource SelectableText}" Text="{Binding Server.ProtocolDisplayName, Mode=OneWay}" />
                                    </Grid>
                                    <Border BorderThickness="0 1 0 0" BorderBrush="{DynamicResource IslandDividerBrush}" />
                                    <Grid Margin="16 12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource Last connection}" />
                                        <TextBox Grid.Column="1" Style="{StaticResource SelectableText}" Text="{Binding LastConnectText, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding DetailQuick, Converter={StaticResource ConverterEqual2Collapsed}, ConverterParameter={x:Null}}">
                        <StackPanel Margin="20" DataContext="{Binding DetailQuick}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" Background="{DynamicResource PrimaryDarkBrush}" BorderThickness="1"
                                        BorderBrush="{DynamicResource IslandBorderBrush}" CornerRadius="{StaticResource IslandRadius}">
                                    <TextBlock Text="{Binding ProtocolUpper}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Style="{StaticResource TextBlockBase}" Foreground="{DynamicResource ProtocolOtherBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14 0 0 0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBlockBase}"
                                               FontSize="{fpx:FontPx 22}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{DynamicResource quick_detail_note}" Style="{StaticResource TextBlockBase}" MaxHeight="20"
                                               Foreground="{DynamicResource IslandSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <Button Style="{StaticResource BtnPrimary}" Margin="0 18 0 0" Content="{DynamicResource Connect}" Click="QuickDetailConnect_OnClick" />
                            <WrapPanel Margin="0 8 0 0">
                                <Button Style="{StaticResource BtnSecondary}" Margin="0 0 6 6" Content="{DynamicResource quick_detail_save}" Click="QuickDetailSave_OnClick" />
                                <Button Style="{StaticResource BtnDanger}" Margin="0 0 6 6" Content="{DynamicResource quick_detail_remove}" Click="QuickDetailRemove_OnClick" />
                            </WrapPanel>
                            <Border Margin="0 8 0 0" Background="{DynamicResource PrimaryDarkBrush}" BorderThickness="1"
                                    BorderBrush="{DynamicResource IslandBorderBrush}" CornerRadius="{StaticResource IslandRadius}">
                                <StackPanel>
                                    <StackPanel.Resources>
                                        <Style x:Key="QLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                            <Setter Property="Foreground" Value="{DynamicResource IslandSecondaryTextBrush}" />
                                            <Setter Property="VerticalAlignment" Value="Top" />
                                        </Style>
                                        <Style x:Key="QValue" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="VerticalAlignment" Value="Top" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <Grid Margin="16 12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource QLabel}" Text="{DynamicResource Target}" />
                                        <TextBox Grid.Column="1" Style="{StaticResource SelectableText}" Text="{Binding HostText, Mode=OneWay}" />
                                    </Grid>
                                    <Border BorderThickness="0 1 0 0" BorderBrush="{DynamicResource IslandDividerBrush}" />
                                    <Grid Margin="16 12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource QLabel}" Text="{DynamicResource User}" />
                                        <TextBox Grid.Column="1" Style="{StaticResource SelectableText}" Text="{Binding UserText, Mode=OneWay}" />
                                    </Grid>
                                    <Border BorderThickness="0 1 0 0" BorderBrush="{DynamicResource IslandDividerBrush}" />
                                    <Grid Margin="16 12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource QLabel}" Text="{DynamicResource Protocol}" />
                                        <TextBox Grid.Column="1" Style="{StaticResource SelectableText}" Text="{Binding ProtocolUpper, Mode=OneWay}" />
                                    </Grid>
                                    <Border BorderThickness="0 1 0 0" BorderBrush="{DynamicResource IslandDividerBrush}" />
                                    <Grid Margin="16 12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource QLabel}" Text="{DynamicResource Last connection}" />
                                        <TextBox Grid.Column="1" Style="{StaticResource SelectableText}" Text="{Binding LastConnectText, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                  </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</serverView:ServerViewBase>