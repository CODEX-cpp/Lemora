                                  ContextMenuOpening="GridNode_OnContextMenuOpening"
                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=serverTree:ServerTreeView} }"
                            >
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <!-- highlight when mouseover -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Color="{DynamicResource BackgroundTextColor}" Opacity="0.3"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <!-- For folder nodes -->
                                        <MenuItem Header="{DynamicResource 'New server'}" 
                                                  Visibility="{Binding IsFolder, Converter={StaticResource ConverterBool2Visible}}"
                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.Tag.CmdAddServerToNode}" 
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <Path Data="{StaticResource GeometryCross}" 
                                                      Width="12" Height="12" 
                                                      Fill="{DynamicResource PrimaryTextBrush}" 
                                                      Stretch="Uniform"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource 'Create a folder'}"
                                                  Visibility="{Binding ShowCreateFolder, Converter={StaticResource ConverterBool2Visible}}"
                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.Tag.CmdCreateFolder}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <Path Data="M10 4H4c-1.11 0-2 .89-2 2v12c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2h-8l-2-2z" 
                                                      Width="12" Height="12" 
                                                      Fill="{DynamicResource PrimaryTextBrush}" 
                                                      Stretch="Uniform"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <!-- azioni di scrittura: nascoste per le voci in sola lettura (Teams senza permesso) e per le cartelle che ne contengono -->
                                        <MenuItem Header="{DynamicResource Rename}"
                                                  Visibility="{Binding ShowFolderWriteActions, Converter={StaticResource ConverterBool2Visible}}"
                                                  IsEnabled="{Binding IsRootFolder, Converter={StaticResource ConverterBoolInverse}}"
                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.Tag.CmdEditNode}"
                                                  CommandParameter="{Binding}">
                                            <!--<MenuItem.Icon>
                                                <Path Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z" 
                                                      Width="12" Height="12" 
                                                      Fill="{DynamicResource PrimaryTextBrush}" 
                                                      Stretch="Uniform"/>
                                            </MenuItem.Icon>-->
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Edit}"
                                                  Visibility="{Binding ShowFolderWriteActions, Converter={StaticResource ConverterBool2Visible}}"
                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.Tag.CmdMultiEditFolderServers}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" 
                                                      Width="12" Height="12" 
                                                      Fill="{DynamicResource PrimaryTextBrush}" 
                                                      Stretch="Uniform"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <!--<Separator Visibility="{Binding IsFolder, Converter={StaticResource ConverterBool2Visible}}"/>-->

                                        <!-- For server nodes -->
                                        <MenuItem Header="{DynamicResource Connect}" 
                                                  Visibility="{Binding IsFolder, Converter={StaticResource ConverterBool2VisibleInv}}"
                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.Tag.CmdConnectSelected}">
                                            <MenuItem.Icon>
                                                <Path Data="M12 2l3.09 6.26L22 9l-5.55 5.15L18 22l-6-3.27L6 22l1.55-7.85L2 9l6.91-.74L12 2z" 
                                                      Width="12" Height="12" 
                                                      Fill="{DynamicResource PrimaryTextBrush}" 
                                                      Stretch="Uniform"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Edit}"
                                                  Visibility="{Binding ShowServerWriteActions, Converter={StaticResource ConverterBool2Visible}}"
                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.Tag.CmdEditNode}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" 
                                                      Width="12" Height="12" 
                                                      Fill="{DynamicResource PrimaryTextBrush}" 
                                                      Stretch="Uniform"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <!-- todo: Duplicate 有错误 -->
                                        <MenuItem Header="{DynamicResource Duplicate}"
                                                  Visibility="{Binding ShowServerWriteActions, Converter={StaticResource ConverterBool2Visible}}"
                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.Tag.CmdDuplicateNode}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <Path Data="{StaticResource GeometryCross}" 
                                                      Width="12" Height="12" 
                                                      Fill="{DynamicResource PrimaryTextBrush}" 
                                                      Stretch="Uniform"/>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <!--<Separator Visibility="{Binding IsFolder, Converter={StaticResource ConverterBool2VisibleInv}}"/>-->

                                        <!-- Common items -->


                                        <!-- separatore solo se sotto c'e' Elimina (in sola lettura restava un separatore vuoto in fondo) -->
                                        <Separator Visibility="{Binding IsReadOnly, Converter={StaticResource ConverterBool2VisibleInv}}"/>
                                        <MenuItem Tag="danger" Header="{DynamicResource Delete}"
                                                  Visibility="{Binding IsReadOnly, Converter={StaticResource ConverterBool2VisibleInv}}"
                                                  IsEnabled="{Binding IsRootFolder, Converter={StaticResource ConverterBoolInverse}}"
                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.Tag.CmdDeleteNode}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" 
                                                      Width="12" Height="12" 
                                                      Fill="{DynamicResource PrimaryTextBrush}" 
                                                      Stretch="Uniform"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <Grid Margin="0 3 20 3" MinWidth="200" MinHeight="20"
                                      Background="Transparent"
                                      MouseLeftButtonDown="TreeViewItemGrid_OnMouseLeftButtonDown">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!--<Border BorderThickness="1 0 0 0" BorderBrush=""></Border>-->

                                    <!-- For folder nodes -->
                                    <Border Grid.Column="0" Grid.ColumnSpan="2"
                                            Visibility="{Binding IsFolder, Converter={StaticResource ConverterBool2Visible}}"
                                            VerticalAlignment="Center"
                                            >
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Margin="3 0 0 0" 
                                                      Width="20" Height="20" 
                                                      HorizontalAlignment="Left" 
                                                      Click="ItemsCheckBox_OnClick"
                                                      Style="{StaticResource SelectedCheckBoxStyle}"
                                                      IsChecked="{Binding IsCheckboxSelected, UpdateSourceTrigger=PropertyChanged}">
                                            </CheckBox>
                                            <Grid Width="16" Height="16" Margin="0,0,4,0">
                                                <Path Visibility="{Binding IsRootFolder, Converter={StaticResource ConverterBool2VisibleInv}}"
                                                      Fill="{DynamicResource AccentMidBrush}" 
                                                      Stretch="Uniform"
                                                      Data="{StaticResource GeometryFolder}"/>
                                                <Path Visibility="{Binding IsRootFolder, Converter={StaticResource ConverterBool2Visible}}"
                                                      Fill="{DynamicResource AccentMidBrush}"
                                                      Stretch="Uniform"
                                                      Data="{DynamicResource GeometryDatabase}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" 
                                                       Foreground="{DynamicResource BackgroundTextBrush}" 
                                                       FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- For server nodes -->
                                    <Grid Grid.Column="0" Grid.ColumnSpan="2"
                                          Background="Transparent" 
                                          Visibility="{Binding IsFolder, Converter={StaticResource ConverterBool2VisibleInv}}"
                                          VerticalAlignment="Center">
                                        <Grid.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding Server.CmdConnServer}"></MouseBinding>
                                        </Grid.InputBindings>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>


                                        <CheckBox Grid.Column="0" Margin="3 0 0 0" 
                                                  Width="20" Height="20" 
                                                  HorizontalAlignment="Left" 
                                                  Click="ItemsCheckBox_OnClick"
                                                  Style="{StaticResource SelectedCheckBoxStyle}"
                                                  IsChecked="{Binding IsCheckboxSelected, UpdateSourceTrigger=PropertyChanged}">
                                        </CheckBox>

                                        <Grid Grid.Column="1" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- voce condivisa dal server Teams: nuvola subito dopo il nome (prima della nota) -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="6 1 0 0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentMidBrush}" Background="Transparent"
                                                           Visibility="{Binding Server.IsTeams, Converter={StaticResource ConverterBool2Visible}}"
                                                           ToolTip="{DynamicResource teams_shared_tip}" AutomationProperties.Name="{DynamicResource teams_shared_tip}" />
                                                <!-- richiesta in attesa dell'amministratore: orologio dopo la nuvola -->
                                                <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="4 1 0 0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentMidBrush}" Background="Transparent"
                                                           Visibility="{Binding Server.IsTeamsPending, Converter={StaticResource ConverterBool2Visible}, FallbackValue=Collapsed}"
                                                           ToolTip="{DynamicResource teams_pending_tip}" AutomationProperties.Name="{DynamicResource teams_pending_tip}" />
                                            </StackPanel>

                                            <Image Grid.Column="0"
                                                   Width="16" Height="16" Margin="0,0,4,0"
                                                   Source="{Binding Server.Server.IconImg}" 
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   VerticalAlignment="Center"/>

                                            <!-- Server Name -->
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Server.DisplayName}" 
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Server.DisplayName}"/>

                                            <!--brief note -->
                                            <ContentControl Grid.Column="3"
                                                            Margin="0 0 10 0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding Server.HoverNoteDisplayControl, Converter={StaticResource ConverterEqual2Collapsed}, ConverterParameter={x:Null}}"
                                                            Content="{Binding Server.HoverNoteDisplayControl}"></ContentControl>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- footer: show detail of a server -->
                <Grid Name="GridBottom" VerticalAlignment="Bottom" Height="30" Background="{DynamicResource PrimaryMidBrush}" IsHitTestVisible="False">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="0.9"></Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedServerViewModel}" Value="{x:Null}">
                                    <Setter Property="Opacity" Value="0"></Setter>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0"></Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock Margin="5 0 10 0" 
                               Style="{StaticResource TextBlockBase}"
                               Text="{Binding SelectedServerViewModel.Server.ProtocolDisplayName}"
                               FontSize="{DynamicResource GlobalFontSizeSubtitle}" FontWeight="Bold"
                               Opacity="0.6"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center">
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"></Setter>
                                <Setter Property="Margin" Value="0 0 5 0"></Setter>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="{Binding SelectedServerViewModel.Server.DisplayName}" Style="{StaticResource TextBlockBase}" Margin="5 0"></TextBlock>
                        <TextBlock Text="{Binding SelectedServerViewModel.Server.SubTitle}" Style="{StaticResource TextBlockBase}"></TextBlock>
                    </StackPanel>
                </Grid>

            </Grid>


            <!-- Popup when any item is selected -->
            <Grid Grid.Row="2" Background="{DynamicResource PrimaryMidBrush}" Height="40">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"></Setter>
                        <Setter Property="Margin" Value="0 0 0 -50"></Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAnySelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible"></Setter>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimationUsingKeyFrames BeginTime="0:0:0" Storyboard.TargetProperty="Margin" AccelerationRatio="0.9">
                                                <SplineThicknessKeyFrame KeyTime="0:0:0.0" Value="0,0,0,-50" />
                                                <SplineThicknessKeyFrame KeyTime="0:0:0.400" Value="0,0,0,0" />
                                            </ThicknessAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimationUsingKeyFrames BeginTime="0:0:0" Storyboard.TargetProperty="Margin">
                                                <SplineThicknessKeyFrame KeyTime="0:0:0.0" Value="0,0,0,0" />
                                                <SplineThicknessKeyFrame KeyTime="0:0:0.200" Value="0,0,0,-50" />
                                            </ThicknessAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- due colonne: i pulsanti a destra restano interi, con la finestra stretta si accorcia il testo "elementi selezionati" (prima i pulsanti coprivano "Annulla") -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" ClipToBounds="True">
                    <Button Height="30" MinWidth="80" Margin="5 0" Content="{DynamicResource Cancel}" Command="{Binding CmdCancelSelected}"></Button>
                    <TextBlock Style="{StaticResource TextBlockBase}" Text="{DynamicResource server_editor_multi_selected_count}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"></TextBlock>
                    <TextBlock Style="{StaticResource TextBlockBase}" Text="{Binding SelectedCount}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="5 0 0 0"></TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel.Resources>
                        <!-- Modifica/Elimina: nascosti se la selezione contiene voci in sola lettura (CanExecute falso) -->
                        <Style x:Key="BtnHideDisabled" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>
                    <Button Height="30" MinWidth="80" Margin="5 0 0 0" Content="{DynamicResource Connect}" Command="{Binding CmdConnectSelected}"></Button>
                    <Button Style="{StaticResource BtnHideDisabled}" Height="30" MinWidth="80" Margin="5 0 0 0" Content="{DynamicResource Edit}" Command="{Binding CmdMultiEditSelected}"></Button>
                    <Button Height="30" MinWidth="80" Margin="5 0 0 0" Content="{DynamicResource 'Create desktop shortcut'}" Command="{Binding CmdCreateDesktopShortcut}"></Button>
                    <Button Style="{StaticResource BtnHideDisabled}" Height="30" MinWidth="80" Margin="5 0 0 0" Content="{DynamicResource Delete}" Command="{Binding CmdDeleteSelected}"></Button>
                    <Button Style="{StaticResource BtnHideDisabled}" Height="30" MinWidth="80" Margin="5 0" Content="{DynamicResource Export}" Command="{Binding CmdExportSelectedToJson}"></Button>
                </StackPanel>
            </Grid>
        </Grid>




                </Border>

                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

                <ContentControl Grid.Column="2" Grid.ColumnSpan="3" Panel.ZIndex="5"
                                s:View.Model="{Binding TagListViewModel}"
                                Visibility="{Binding TagListViewModel, Converter={StaticResource ConverterEqual2Collapsed}, ConverterParameter={x:Null}}" />

                <ContentControl Grid.Column="2" Grid.ColumnSpan="3" Panel.ZIndex="6"
                                s:View.Model="{Binding FolderEditViewModel}"
                                Visibility="{Binding FolderEditViewModel, Converter={StaticResource ConverterEqual2Collapsed}, ConverterParameter={x:Null}}" />

                <!-- isola dettaglio: ultimo server su cui si e' cliccato -->
                <Border Grid.Column="4" Style="{StaticResource IslandBorder}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding SelectedServerViewModel, Converter={StaticResource ConverterEqual2Collapsed}, ConverterParameter={x:Null}}">
                        <StackPanel Margin="20" DataContext="{Binding SelectedServerViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" Background="{DynamicResource PrimaryDarkBrush}" BorderThickness="1"
                                        BorderBrush="{DynamicResource IslandBorderBrush}" CornerRadius="{StaticResource IslandRadius}">
                                    <TextBlock Text="{Binding Server.ProtocolDisplayName}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                                <Setter Property="Foreground" Value="{DynamicResource ProtocolOtherBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Server.ProtocolDisplayName}" Value="RDP"><Setter Property="Foreground" Value="{DynamicResource ProtocolRdpBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Server.ProtocolDisplayName}" Value="SSH"><Setter Property="Foreground" Value="{DynamicResource ProtocolSshBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Server.ProtocolDisplayName}" Value="VNC"><Setter Property="Foreground" Value="{DynamicResource ProtocolVncBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Server.ProtocolDisplayName}" Value="SFTP"><Setter Property="Foreground" Value="{DynamicResource ProtocolSftpBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14 0 0 0" VerticalAlignment="Center">
                                    <!-- nome e, subito a destra, la nuvola delle voci Teams -->
                                    <DockPanel HorizontalAlignment="Left">
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Margin="6 2 0 0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentMidBrush}" Background="Transparent"
                                                   Visibility="{Binding IsTeamsPending, Converter={StaticResource ConverterBool2Visible}, FallbackValue=Collapsed}"
                                                   ToolTip="{DynamicResource teams_pending_tip}" AutomationProperties.Name="{DynamicResource teams_pending_tip}" />
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Margin="8 2 0 0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentMidBrush}" Background="Transparent"
                                                   Visibility="{Binding IsTeams, Converter={StaticResource ConverterBool2Visible}, FallbackValue=Collapsed}"
                                                   ToolTip="{DynamicResource teams_shared_tip}" AutomationProperties.Name="{DynamicResource teams_shared_tip}" />
                                        <TextBlock Text="{Binding Server.DisplayName}" Style="{StaticResource TextBlockBase}"
                                                   FontSize="{fpx:FontPx 22}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Server.Note}" Style="{StaticResource TextBlockBase}" MaxHeight="20"
                                               Foreground="{DynamicResource IslandSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <!-- azioni: Connetti (con le varianti nella freccia), poi Modifica, Duplica, Copia, Altro, Elimina -->
                            <Grid Margin="0 18 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource BtnPrimary}" Command="{Binding CmdConnServer}" Content="{DynamicResource Connect}" />
                                <CheckBox x:Name="CbConnectMore" Grid.Column="1" Margin="6 0 0 0" Style="{StaticResource BtnDropdownIcon}"
                                          ToolTip="{DynamicResource Connect}"
                                          Visibility="{Binding DetailActionSet.HasConnectActions, Converter={StaticResource ConverterBool2Visible}}" />
                                <Popup Grid.Column="1" IsOpen="{Binding ElementName=CbConnectMore, Path=IsChecked}" StaysOpen="False" AllowsTransparency="True"
                                       Placement="Bottom" PlacementTarget="{Binding ElementName=CbConnectMore}">
                                    <Border Margin="0 4 0 0" Padding="4" MinWidth="220" Background="{DynamicResource PrimaryDarkBrush}"
                                            BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource IslandRadius}">
                                        <ItemsControl ItemsSource="{Binding DetailActionSet.ConnectActions, Mode=OneWay}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource BtnNav}" Height="34" HorizontalContentAlignment="Left"
                                                            Content="{Binding ActionName}" CommandParameter="{Binding}" Click="DetailAction_OnClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                            </Grid>

                            <WrapPanel Margin="0 8 0 0">
                                <!-- nascosto se l'origine e' in sola lettura (CanExecute di CmdEditServer): senza permesso il pulsante non si mostra -->
                                <Button Margin="0 0 6 6" Command="{Binding CmdEditServer}" Content="{DynamicResource Edit}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Style="{StaticResource BtnSecondary}" Margin="0 0 6 6" Content="{DynamicResource Duplicate}"
                                        CommandParameter="{Binding DetailActionSet.Duplicate}" Click="DetailAction_OnClick"
                                        Visibility="{Binding DetailActionSet.HasDuplicate, Converter={StaticResource ConverterBool2Visible}}" />
                                <Grid Margin="0 0 6 6" Visibility="{Binding DetailActionSet.HasCopyActions, Converter={StaticResource ConverterBool2Visible}}">
                                    <CheckBox x:Name="CbCopyMore" Style="{StaticResource BtnDropdown}" Content="{DynamicResource Copy}" />
                                <Popup IsOpen="{Binding ElementName=CbCopyMore, Path=IsChecked}" StaysOpen="False" AllowsTransparency="True"
                                       Placement="Bottom" PlacementTarget="{Binding ElementName=CbCopyMore}">
                                    <Border Margin="0 4 0 0" Padding="4" MinWidth="220" Background="{DynamicResource PrimaryDarkBrush}"
                                            BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource IslandRadius}">
                                        <ItemsControl ItemsSource="{Binding DetailActionSet.CopyActions, Mode=OneWay}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource BtnNav}" Height="34" HorizontalContentAlignment="Left"
                                                            Content="{Binding ActionName}" CommandParameter="{Binding}" Click="DetailAction_OnClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                                </Grid>
                                <Grid Margin="0 0 6 6" Visibility="{Binding DetailActionSet.HasExportActions, Converter={StaticResource ConverterBool2Visible}}">
                                    <CheckBox x:Name="CbOtherMore" Style="{StaticResource BtnDropdown}" Content="{Binding DetailActionSet.ExportLabel}" />
                                <Popup IsOpen="{Binding ElementName=CbOtherMore, Path=IsChecked}" StaysOpen="False" AllowsTransparency="True"
                                       Placement="Bottom" PlacementTarget="{Binding ElementName=CbOtherMore}">
                                    <Border Margin="0 4 0 0" Padding="4" MinWidth="220" Background="{DynamicResource PrimaryDarkBrush}"
                                            BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource IslandRadius}">
                                        <ItemsControl ItemsSource="{Binding DetailActionSet.ExportActions, Mode=OneWay}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource BtnNav}" Height="34" HorizontalContentAlignment="Left"
                                                            Content="{Binding ActionName}" CommandParameter="{Binding}" Click="DetailAction_OnClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                                </Grid>
                                <Button Style="{StaticResource BtnDanger}" Margin="0 0 6 6" Content="{DynamicResource Delete}"
                                        CommandParameter="{Binding DetailActionSet.Delete}" Click="DetailAction_OnClick"
                                        Visibility="{Binding DetailActionSet.HasDelete, Converter={StaticResource ConverterBool2Visible}}" />
                            </WrapPanel>

                            <!-- riquadro incassato con i dati della connessione -->
                            <Border Margin="0 8 0 0" Background="{DynamicResource PrimaryDarkBrush}" BorderThickness="1"
                                    BorderBrush="{DynamicResource IslandBorderBrush}" CornerRadius="{StaticResource IslandRadius}">
                                <StackPanel>
                                    <StackPanel.Resources>
                                        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                            <Setter Property="Foreground" Value="{DynamicResource IslandSecondaryTextBrush}" />
                                            <Setter Property="VerticalAlignment" Value="Top" />
                                        </Style>
                                        <Style x:Key="DetailValue" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="VerticalAlignment" Value="Top" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <Grid Margin="16 12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource Target}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding HostText}" />
                                    </Grid>
                                    <Border BorderThickness="0 1 0 0" BorderBrush="{DynamicResource IslandDividerBrush}" />
                                    <Grid Margin="16 12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource User}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding AllUsersText}" />
                                    </Grid>
                                    <Border BorderThickness="0 1 0 0" BorderBrush="{DynamicResource IslandDividerBrush}" />
                                    <Grid Margin="16 12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource Protocol}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding Server.ProtocolDisplayName}" />
                                    </Grid>
                                    <Border BorderThickness="0 1 0 0" BorderBrush="{DynamicResource IslandDividerBrush}" />
                                    <Grid Margin="16 12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource Last connection}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding LastConnectText}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>


    </Grid>

</serverView:ServerViewBase>
