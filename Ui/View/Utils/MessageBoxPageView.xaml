<UserControl x:Class="Lemora.View.Utils.MessageBoxPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fpx="clr-namespace:Lemora.Utils"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Lemora.View.Utils"
      xmlns:ctl="clr-namespace:Lemora.Controls"
      xmlns:service="clr-namespace:Lemora.Service"
      xmlns:xaml="https://github.com/canton7/Stylet"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance local:MessageBoxPageViewModel}"
      d:DesignHeight="450" d:DesignWidth="800"
      FlowDirection="{Binding FlowDirection}">

    <UserControl.Resources>
        <Style x:Key="MsgText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
            <Setter Property="Foreground" Value="{DynamicResource IslandSecondaryTextBrush}"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="TextWrapping" Value="Wrap"></Setter>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxAccentStyle}">
            <Setter Property="Margin" Value="0 5 0 15"></Setter>
        </Style>
    </UserControl.Resources>

    <!-- finestra di messaggio in pagina (blueprint §12): barra titolo, icona tonda, titolo + testo, pulsanti nel piè; la risposta positiva e' il pulsante primario -->
    <ctl:DialogFrame Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="400" MaxWidth="520" Title="{Binding DisplayName}" ShowClose="False">
        <ctl:DialogFrame.Footer>
            <ItemsControl ItemsSource="{Binding ButtonList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10 0 0 0">
                            <!-- Si / OK: primario; No / Annulla: secondario -->
                            <Button MinWidth="90" Command="{xaml:Action ButtonClicked}" CommandParameter="{Binding Value}" Content="{Binding Label}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Value}" Value="{x:Static MessageBoxResult.No}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Value}" Value="{x:Static MessageBoxResult.Cancel}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button MinWidth="90" Command="{xaml:Action ButtonClicked}" CommandParameter="{Binding Value}" Content="{Binding Label}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Value}" Value="{x:Static MessageBoxResult.No}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Value}" Value="{x:Static MessageBoxResult.Cancel}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ctl:DialogFrame.Footer>

        <Grid Margin="24 24 24 24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ctl:DialogIcon Kind="{Binding IconKind}" Margin="0 0 18 0"
                            Visibility="{Binding HasIcon, Converter={x:Static xaml:BoolToVisibilityConverter.Instance}}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource MsgText}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="{fpx:FontPx 16}" FontWeight="SemiBold" Margin="0 0 0 8"
                           Text="{Binding Heading}" TextAlignment="{Binding TextAlignment}"
                           Visibility="{Binding HasHeading, Converter={x:Static xaml:BoolToVisibilityConverter.Instance}}" />
                <TextBlock Style="{StaticResource MsgText}" FontSize="{fpx:FontPx 14}" Text="{Binding Body}" TextAlignment="{Binding TextAlignment}" />
            </StackPanel>
        </Grid>
    </ctl:DialogFrame>
</UserControl>
