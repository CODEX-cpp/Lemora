<UserControl x:Class="Lemora.View.Utils.UpdateBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setup="clr-namespace:Lemora.Setup"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
    <!-- Update box above "Options" (as in TrackFlow): "Downloading" then "Restart to update". Hidden when there is nothing to do.
         The page DataContext stays the page's own (LayoutMode is needed for the icon-only bar); the state is UpdateController.State. -->
    <Button x:Name="Btn" Height="46" Margin="0 0 0 4" DataContext="{x:Static setup:UpdateController.State}"
            Command="{Binding CmdClick}" Style="{StaticResource BtnNav}" Visibility="Collapsed">
        <Button.ToolTip>
            <TextBlock Text="{Binding Title}" />
        </Button.ToolTip>
        <Grid>
            <!-- wide bar: icon or spinner, title and version -->
            <Grid x:Name="Wide">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="22" Height="22" Margin="0 0 10 0" VerticalAlignment="Center">
                    <TextBlock x:Name="WideIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="&#xE895;" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentMidBrush}" />
                    <ProgressBar x:Name="WideSpin" IsIndeterminate="True" Visibility="Collapsed" Height="3" VerticalAlignment="Bottom" Margin="0 0 0 -4" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource GlobalFontSizeSmall}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Sub}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <!-- icon-only bar -->
            <TextBlock x:Name="NarrowIcon" Visibility="Collapsed" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="&#xE895;"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentMidBrush}" />
        </Grid>
    </Button>
</UserControl>
