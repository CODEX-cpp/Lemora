    <!-- riga impostazione: Header = titolo, Tag = descrizione, Content = controllo a destra -->
    <Style x:Key="SettingRow" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Padding="2 13" BorderThickness="0 0 0 1" BorderBrush="{DynamicResource IslandDividerBrush}" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0 0 24 0">
                                <ContentPresenter ContentSource="Header" TextElement.FontSize="{fpx:FontPx 14.5}" TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock x:Name="Desc" Text="{TemplateBinding Tag}" FontSize="{fpx:FontPx 12.5}" TextWrapping="Wrap" Margin="0 3 0 0"
                                           Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- scheda nella barra del titolo (Home, Impostazioni): Tag="True" = attiva, fondo come la barra strumenti e filo accento sopra -->
    <!-- scheda della barra del titolo (blueprint §3): inattiva piu' bassa (32) e scura con bordo sottile, attiva (36) della stessa tinta della barra
         e unita ad essa, con il filo accent di 2 px sopra -->
    <Style x:Key="BtnTab" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource IslandSecondaryTextBrush}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14 0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid VerticalAlignment="Bottom" Height="{TemplateBinding Height}">
                        <Border x:Name="Bd" Background="{DynamicResource IslandSubCardBrush}" CornerRadius="4 4 0 0" BorderThickness="1 1 1 0" BorderBrush="{DynamicResource IslandBorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <!-- filo accent di 2 px solo in alto sulla scheda attiva -->
                        <Border x:Name="TopLine" Height="2" VerticalAlignment="Top" CornerRadius="4 4 0 0" Background="{DynamicResource AccentMidBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IslandHoverBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="True">
                            <Setter Property="Height" Value="36" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryMidBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource IslandButtonBorderBrush}" />
                            <Setter TargetName="TopLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- scheda "+": solo il segno, senza riquadro -->
                        <Trigger Property="Tag" Value="Add">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="0" />
                        </Trigger>
                        <!-- "+" col mouse sopra: riquadro tenue arrotondato e segno piu' chiaro (la regola sopra toglieva anche l'effetto) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Add" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IslandHoverBrush}" />
                            <Setter TargetName="Bd" Property="CornerRadius" Value="4" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- titolo di sezione nelle pagine di impostazioni -->
    <Style x:Key="SettingSection" TargetType="TextBlock">
